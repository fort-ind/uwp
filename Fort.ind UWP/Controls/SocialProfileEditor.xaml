<UserControl
    x:Class="Fort.ind_UWP.SocialProfileEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fort.ind_UWP"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE77B;" FontSize="14" Opacity="0.7" AutomationProperties.AccessibilityView="Raw"/>
            <TextBlock x:Uid="SocialProfileEditorHeading" Style="{StaticResource BodyTextBlockStyle}" FontWeight="SemiBold"
                       AutomationProperties.HeadingLevel="Level3"/>
        </StackPanel>

        <StackPanel x:Name="SignedOutPanel" Margin="0,8,0,0" Visibility="Collapsed">
            <TextBlock x:Uid="SocialProfileEditorSignedOut"
                       Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
            <Button x:Uid="SocialProfileEditorSignInButton" Margin="0,12,0,0" Click="SignInButton_Click"/>
        </StackPanel>

        <StackPanel x:Name="EditorPanel" MaxWidth="480" HorizontalAlignment="Left">
            <Grid x:Name="Card"
                  Margin="0,12,0,0"
                  Background="{ThemeResource CardBackgroundBrush}"
                  BorderBrush="{ThemeResource CardBorderBrush}"
                  BorderThickness="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid x:Name="BannerHost"
                      FlowDirection="LeftToRight"
                      SizeChanged="BannerHost_SizeChanged"
                      AutomationProperties.AccessibilityView="Raw">
                    <Rectangle Fill="{ThemeResource SystemControlBackgroundListLowBrush}"/>
                    <Rectangle x:Name="BannerPlaceholder"/>
                    <Rectangle x:Name="BannerImage"/>
                </Grid>

                <PersonPicture x:Name="AvatarPicture"
                               Grid.Row="1"
                               Width="80" Height="80"
                               Margin="16,-40,0,12"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               AutomationProperties.AccessibilityView="Raw"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                <Button x:Uid="SocialProfileChangeAvatarButton" x:Name="ChangeAvatarButton" Click="ChangeAvatarButton_Click"/>
                <Button x:Uid="SocialProfileChangeBannerButton" x:Name="ChangeBannerButton" Click="ChangeBannerButton_Click"/>
            </StackPanel>

            <Grid Margin="0,24,0,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Uid="SocialProfileNameBox"
                         x:Name="NameBox"
                         IsSpellCheckEnabled="False"
                         TextChanged="Field_TextChanged">
                    <i:Interaction.Behaviors>
                        <local:SocialSuggestionsBehavior SuggestPeople="False" SuggestHashtags="False"/>
                    </i:Interaction.Behaviors>
                </TextBox>
                <local:SocialCharacterRing x:Name="NameRing" Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
            </Grid>

            <Grid Margin="0,24,0,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Uid="SocialProfileBioBox"
                         x:Name="BioBox"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         IsSpellCheckEnabled="True"
                         MinHeight="120"
                         TextChanged="Field_TextChanged">
                    <i:Interaction.Behaviors>
                        <local:SocialSuggestionsBehavior SuggestPeople="False" SuggestHashtags="False"/>
                    </i:Interaction.Behaviors>
                </TextBox>
                <local:SocialCharacterRing x:Name="BioRing" Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,24,0,0">
                <Button x:Uid="SocialProfileSaveButton" x:Name="SaveButton"
                        Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="False"
                        Click="SaveButton_Click"/>
                <Button x:Uid="SocialProfileDiscardButton" x:Name="DiscardButton"
                        IsEnabled="False"
                        Click="DiscardButton_Click"/>
            </StackPanel>

            <ProgressBar x:Uid="SocialProfileSaving" x:Name="SaveProgress"
                         Margin="0,12,0,0"
                         Maximum="1"
                         Visibility="Collapsed"/>

            <TextBlock x:Name="StatusText"
                       Margin="0,8,0,0"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                       AutomationProperties.LiveSetting="Polite"
                       Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel x:Name="AccountTypePanel" Margin="0,32,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE99A;" FontSize="14" Opacity="0.7" AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock x:Uid="SocialProfileAccountTypeHeading" Style="{StaticResource BodyTextBlockStyle}" FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="Level3"/>
            </StackPanel>

            <ToggleSwitch x:Uid="SocialProfileBotToggle" x:Name="BotToggle" Margin="0,8,0,0" Toggled="FlagToggle_Toggled"/>
            <TextBlock x:Uid="SocialProfileBotDescription"
                       Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>

            <ToggleSwitch x:Uid="SocialProfileCatToggle" x:Name="CatToggle" Margin="0,14,0,0" Toggled="FlagToggle_Toggled"/>
            <TextBlock x:Uid="SocialProfileCatDescription"
                       Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>

            <StackPanel x:Name="SpeakAsCatPanel" Margin="0,14,0,0" Visibility="Collapsed">
                <ToggleSwitch x:Uid="SocialProfileSpeakAsCatToggle" x:Name="SpeakAsCatToggle" Toggled="FlagToggle_Toggled"/>
                <TextBlock x:Uid="SocialProfileSpeakAsCatDescription"
                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
