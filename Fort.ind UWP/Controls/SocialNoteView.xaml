<UserControl
    x:Class="Fort.ind_UWP.SocialNoteView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fort.ind_UWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalAlignment="Stretch">

    <Grid x:Name="RowHost">
        <Grid x:Name="ThreadLines"
              HorizontalAlignment="Left"
              Visibility="Collapsed"
              AutomationProperties.AccessibilityView="Raw"/>

        <Grid x:Name="RowGrid"
              Padding="12,10,12,6"
              ColumnSpacing="12"
              BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="TilePlateSource"
                    Visibility="Collapsed"
                    Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"/>

            <StackPanel x:Name="ContextPanel"
                        x:Load="False"
                        Grid.Column="1"
                        Spacing="2"
                        Margin="0,0,0,4">
                <StackPanel x:Name="PinnedLine" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE718;"
                              FontSize="12"
                              Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                              IsTextScaleFactorEnabled="False"
                              AutomationProperties.AccessibilityView="Raw"/>
                    <TextBlock x:Uid="SocialPinnedNoteLine"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                               AutomationProperties.AccessibilityView="Raw"/>
                </StackPanel>

                <Button x:Name="RenoterButton"
                        Style="{StaticResource SocialBareButtonStyle}"
                        IsTabStop="False"
                        Visibility="Collapsed"
                        Click="RenoterButton_Click"
                        AutomationProperties.AccessibilityView="Raw">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8EE;"
                                  FontSize="12"
                                  Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                  IsTextScaleFactorEnabled="False"/>
                        <TextBlock x:Name="RenoterText"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Button>

                <Button x:Name="ReplyToButton"
                        Style="{StaticResource SocialBareButtonStyle}"
                        IsTabStop="False"
                        Visibility="Collapsed"
                        Click="ReplyToButton_Click"
                        AutomationProperties.AccessibilityView="Raw">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE97A;"
                                  FontSize="12"
                                  Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                  IsTextScaleFactorEnabled="False"/>
                        <TextBlock x:Name="ReplyToText"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <Button x:Name="AvatarButton"
                    Grid.Row="1"
                    Style="{StaticResource SocialBareButtonStyle}"
                    Click="AvatarButton_Click">
                <PersonPicture x:Name="AvatarPicture"
                               Width="40" Height="40"
                               AutomationProperties.AccessibilityView="Raw"/>
            </Button>

            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="NameButton"
                            Style="{StaticResource SocialBareButtonStyle}"
                            IsTabStop="False"
                            Click="AvatarButton_Click"
                            AutomationProperties.AccessibilityView="Raw">
                        <RichTextBlock x:Name="NameText"
                                       Style="{StaticResource BaseRichTextBlockStyle}"
                                       IsTextSelectionEnabled="False"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1"/>
                    </Button>

                    <FontIcon x:Name="VisibilityIcon"
                              Grid.Column="1"
                              FontSize="12"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                              IsTextScaleFactorEnabled="False"
                              Visibility="Collapsed"/>

                    <TextBlock x:Name="TimeTextBlock"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                               TextWrapping="NoWrap"/>

                    <TextBlock x:Uid="SocialNoteEditedMarker"
                               x:Name="EditedText"
                               Grid.Column="3"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                               TextWrapping="NoWrap"
                               Visibility="Collapsed"
                               AutomationProperties.AccessibilityView="Raw"/>
                </Grid>

                <TextBlock x:Uid="SocialNoteDeletedLine"
                           x:Name="DeletedLine"
                           x:Load="False"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                           FontStyle="Italic"/>

                <StackPanel x:Name="ContentWarningPanel" x:Load="False" Spacing="6">
                    <TextBlock x:Name="ContentWarningText"
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="Wrap"/>
                    <local:ExpanderHeaderButton x:Name="ContentWarningButton"
                                                Click="ContentWarningButton_Click"/>
                </StackPanel>

                <StackPanel x:Name="ContentPanel" Spacing="8">
                    <RichTextBlock x:Name="BodyText"
                                   Style="{StaticResource BodyRichTextBlockStyle}"
                                   IsTextSelectionEnabled="False"
                                   TextWrapping="Wrap"/>

                    <TextBlock x:Uid="SocialHiddenNoteLine"
                               x:Name="HiddenLine"
                               x:Load="False"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                               FontStyle="Italic"/>

                    <StackPanel x:Name="PollPanel"
                                x:Load="False"
                                Spacing="6"
                                MaxWidth="560"
                                HorizontalAlignment="Stretch"/>

                    <Grid x:Name="MediaGrid"
                          x:Load="False"
                          MaxWidth="560"
                          HorizontalAlignment="Stretch"
                          SizeChanged="MediaGrid_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                    </Grid>

                    <Button x:Name="LinkCardButton"
                            x:Load="False"
                            Style="{StaticResource ButtonRevealStyle}"
                            Background="Transparent"
                            BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1"
                            Padding="8"
                            MaxWidth="560"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Click="LinkCardButton_Click">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="LinkThumbHost"
                                  Width="64" Height="64"
                                  VerticalAlignment="Top"
                                  Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                                  AutomationProperties.AccessibilityView="Raw">
                                <Image x:Name="LinkThumbImage" Stretch="UniformToFill"/>
                            </Grid>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="LinkTitleText"
                                           Style="{StaticResource BaseTextBlockStyle}"
                                           TextWrapping="Wrap"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="LinkDescriptionText"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                           TextWrapping="Wrap"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="LinkSiteText"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button x:Name="QuoteButton"
                            x:Load="False"
                            Style="{StaticResource ButtonRevealStyle}"
                            Background="Transparent"
                            BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1"
                            Padding="10,8,10,10"
                            MaxWidth="560"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Click="QuoteButton_Click">
                        <StackPanel Spacing="4">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PersonPicture x:Name="QuoteAvatar"
                                               Width="20" Height="20"
                                               AutomationProperties.AccessibilityView="Raw"/>
                                <RichTextBlock x:Name="QuoteNameText"
                                               Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource BaseRichTextBlockStyle}"
                                               IsTextSelectionEnabled="False"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1"/>
                                <TextBlock x:Name="QuoteTimeText"
                                           Grid.Column="2"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                           TextWrapping="NoWrap"/>
                            </Grid>
                            <RichTextBlock x:Name="QuoteBodyText"
                                           Style="{StaticResource BodyRichTextBlockStyle}"
                                           IsTextSelectionEnabled="False"
                                           TextWrapping="Wrap"
                                           MaxLines="6"
                                           TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="QuoteAttachmentsText"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock x:Name="FocusedDateText"
                           x:Load="False"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                           TextWrapping="Wrap"/>

                <local:SocialReactionChipPanel x:Name="ReactionChips"
                                               x:Load="False"
                                               Margin="0,2,0,0"
                                               VisibleCountChanged="ReactionChips_VisibleCountChanged"/>

                <Border x:Name="ReactedBrushSource"
                        Visibility="Collapsed"
                        Background="{ThemeResource SocialReactedForegroundBrush}"/>

                <Grid x:Name="ActionBar" Margin="-10,-4,0,-4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="ReplyButton"
                            Style="{StaticResource SocialActionButtonStyle}"
                            Click="ReplyButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE97A;" FontSize="14" IsTextScaleFactorEnabled="False"/>
                            <TextBlock x:Name="RepliesCountText"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="RenoteButton"
                            Grid.Column="1"
                            Style="{StaticResource SocialActionButtonStyle}"
                            Click="RenoteButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="RenoteIcon" Glyph="&#xE8EE;" FontSize="14" IsTextScaleFactorEnabled="False"/>
                            <TextBlock x:Name="RenotesCountText"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <ToggleSplitButton x:Name="ReactButton"
                                       Grid.Column="2"
                                       Style="{StaticResource SocialReactionSplitButtonStyle}"
                                       Click="ReactButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <FontIcon x:Name="LikeIcon" Glyph="&#xEB51;" FontSize="14" IsTextScaleFactorEnabled="False"/>
                                <FontIcon x:Name="LikedIcon"
                                          Glyph="&#xEB52;"
                                          FontSize="14"
                                          IsTextScaleFactorEnabled="False"
                                          Foreground="{ThemeResource SocialReactedForegroundBrush}"
                                          Visibility="Collapsed"/>
                                <TextBlock x:Name="MyReactionText"
                                           FontFamily="Segoe UI Emoji"
                                           FontSize="14"
                                           IsTextScaleFactorEnabled="False"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                                <Image x:Name="MyReactionImage"
                                       Width="16" Height="16"
                                       Stretch="Uniform"
                                       Visibility="Collapsed"/>
                            </Grid>
                            <TextBlock x:Name="ReactionsCountText"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <ToggleSplitButton.Flyout>
                            <Flyout x:Name="ReactFlyout" Opening="ReactFlyout_Opening"/>
                        </ToggleSplitButton.Flyout>
                    </ToggleSplitButton>

                    <Button x:Uid="SocialNoteMoreButton"
                            x:Name="MoreButton"
                            Grid.Column="3"
                            Style="{StaticResource SocialActionButtonStyle}"
                            Width="40"
                            Padding="0"
                            Click="MoreButton_Click">
                        <FontIcon Glyph="&#xE712;" FontSize="16" IsTextScaleFactorEnabled="False"/>
                    </Button>
                </Grid>

                <Button x:Name="ContinueThreadButton"
                        x:Load="False"
                        Style="{StaticResource TextBlockButtonStyle}"
                        Padding="0,4,0,4"
                        Click="ContinueThreadButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
