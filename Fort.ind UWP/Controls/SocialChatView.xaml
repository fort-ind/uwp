<UserControl
    x:Class="Fort.ind_UWP.SocialChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fort.ind_UWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:contract7Present="http://schemas.microsoft.com/winfx/2006/xaml/presentation?IsApiContractPresent(Windows.Foundation.UniversalApiContract,7)"
    mc:Ignorable="d"
    AllowDrop="True"
    SizeChanged="SocialChatView_SizeChanged">

    <UserControl.Resources>
        <DataTemplate x:Key="SocialChatBubbleTemplate" x:DataType="local:SocialChatMessageItem">
            <local:SocialChatBubble Item="{x:Bind}"
                                    AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"/>
        </DataTemplate>

        <Style x:Key="SocialChatItemContainerStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
    </UserControl.Resources>

    <SplitView x:Name="RoomSplit"
               PanePlacement="Right"
               OpenPaneLength="300"
               DisplayMode="Inline"
               IsPaneOpen="False"
               PaneBackground="{ThemeResource CardBackgroundBrush}"
               PaneClosed="RoomSplit_PaneClosed">
        <SplitView.Pane>
            <local:SocialChatRoomPanel x:Name="RoomPanel"/>
        </SplitView.Pane>

        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderBar"
                  Padding="12,8,8,8"
                  ColumnSpacing="8"
                  BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                  BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="PersonButton"
                        Style="{StaticResource SocialBareButtonStyle}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Click="PersonButton_Click">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <PersonPicture x:Name="HeaderPicture"
                                       Width="32" Height="32"
                                       VerticalAlignment="Center"
                                       AutomationProperties.AccessibilityView="Raw"/>
                        <Grid x:Name="HeaderRoomPlate"
                              Width="32" Height="32"
                              VerticalAlignment="Center"
                              Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                              Visibility="Collapsed"
                              AutomationProperties.AccessibilityView="Raw">
                            <FontIcon Glyph="&#xE716;"
                                      FontSize="16"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsTextScaleFactorEnabled="False"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <RichTextBlock x:Name="HeaderName"
                                           Style="{StaticResource BaseRichTextBlockStyle}"
                                           IsTextSelectionEnabled="False"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1"
                                           AutomationProperties.HeadingLevel="Level2"/>
                            <TextBlock x:Name="HeaderHandle"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button x:Uid="SocialChatRoomInfoButton" x:Name="InfoButton"
                        Grid.Column="1"
                        Style="{StaticResource ButtonRevealStyle}"
                        Background="Transparent"
                        Width="40" Height="40"
                        MinWidth="40" MinHeight="40"
                        Padding="0"
                        contract7Present:CornerRadius="0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Click="InfoButton_Click">
                    <FontIcon Glyph="&#xE946;" FontSize="16" IsTextScaleFactorEnabled="False"/>
                </Button>

                <Button x:Uid="SocialChatMoreButton" x:Name="MoreButton"
                        Grid.Column="2"
                        Style="{StaticResource ButtonRevealStyle}"
                        Background="Transparent"
                        Width="40" Height="40"
                        MinWidth="40" MinHeight="40"
                        Padding="0"
                        contract7Present:CornerRadius="0"
                        VerticalAlignment="Center"
                        Click="MoreButton_Click">
                    <FontIcon Glyph="&#xE712;" FontSize="16" IsTextScaleFactorEnabled="False"/>
                </Button>
            </Grid>

            <ListView x:Uid="SocialChatMessageList" x:Name="MessageList"
                      Grid.Row="1"
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      ItemTemplate="{StaticResource SocialChatBubbleTemplate}"
                      ItemContainerStyle="{StaticResource SocialChatItemContainerStyle}"
                      Padding="0,0,0,8"
                      ContextRequested="MessageList_ContextRequested"
                      Loaded="MessageList_Loaded">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel VerticalAlignment="Bottom"
                                         ItemsUpdatingScrollMode="KeepLastItemInView"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>

                <ListView.Header>
                    <StackPanel>
                        <TextBlock x:Uid="SocialChatOlderUnavailable" x:Name="OlderUnavailableText"
                                   Margin="24,12,24,4"
                                   HorizontalAlignment="Center"
                                   MaxWidth="360"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Visibility="Collapsed"/>
                        <local:SocialLoadingIndicator x:Uid="SocialChatOlderLoading" x:Name="OlderLoading"
                                                      Margin="0,8,0,8"
                                                      HorizontalAlignment="Center"
                                                      IsActive="False"
                                                      Visibility="Collapsed"/>
                    </StackPanel>
                </ListView.Header>
            </ListView>

            <local:SocialLoadingIndicator x:Uid="SocialChatLoading" x:Name="LoadingRing"
                                          Grid.Row="1"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          IsActive="False"
                                          Visibility="Collapsed"/>

            <StackPanel x:Name="StatePanel"
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="360"
                        Visibility="Collapsed">
                <TextBlock x:Name="StateText"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"/>
                <Button x:Uid="SocialChatRetryLoadButton" x:Name="StateButton"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed"
                        Click="StateButton_Click"/>
            </StackPanel>

            <TextBlock x:Name="NoticeText"
                       Grid.Row="2"
                       Margin="12,4,12,0"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       AutomationProperties.LiveSetting="Polite"/>

            <Grid x:Name="ComposerBar"
                  Grid.Row="3"
                  Padding="12,8,12,12"
                  ColumnSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid x:Name="AttachmentPanel"
                      Grid.ColumnSpan="5"
                      Margin="0,0,0,8"
                      Padding="8"
                      ColumnSpacing="12"
                      HorizontalAlignment="Left"
                      MinWidth="240"
                      MaxWidth="420"
                      Background="{ThemeResource SystemControlBackgroundListLowBrush}"
                      Visibility="Collapsed"
                      Tapped="AttachmentPanel_Tapped">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="40" Height="40"
                          Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                          AutomationProperties.AccessibilityView="Raw">
                        <FontIcon x:Name="AttachmentGlyph"
                                  Glyph="&#xE8A5;"
                                  FontSize="16"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  IsTextScaleFactorEnabled="False"/>
                        <Image x:Name="AttachmentThumbnail" Stretch="UniformToFill"/>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AttachmentName"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   AutomationProperties.AccessibilityView="Raw"/>
                        <ProgressBar x:Name="AttachmentProgress"
                                     Margin="0,6,0,0"
                                     Maximum="1"
                                     Visibility="Collapsed"
                                     AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock x:Name="AttachmentStatus"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>

                    <Button x:Uid="SocialChatRemoveAttachmentButton" x:Name="RemoveAttachmentButton"
                            Grid.Column="2"
                            Style="{StaticResource ButtonRevealStyle}"
                            Background="Transparent"
                            Width="32" Height="32"
                            MinWidth="32" MinHeight="32"
                            Padding="0"
                            contract7Present:CornerRadius="0"
                            VerticalAlignment="Center"
                            Click="RemoveAttachmentButton_Click">
                        <FontIcon Glyph="&#xE711;" FontSize="12" IsTextScaleFactorEnabled="False"/>
                    </Button>
                </Grid>

                <TextBox x:Uid="SocialChatMessageBox" x:Name="ChatInput"
                         Grid.Row="1"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MaxHeight="160"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VerticalAlignment="Bottom"
                         PreviewKeyDown="ChatInput_PreviewKeyDown"
                         TextChanged="ChatInput_TextChanged"
                         Paste="ChatInput_Paste"/>

                <Button x:Uid="SocialChatAttachButton" x:Name="AttachButton"
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource SocialToolButtonStyle}"
                        VerticalAlignment="Bottom">
                    <FontIcon Glyph="&#xE723;" FontSize="16" IsTextScaleFactorEnabled="False"/>
                    <Button.Flyout>
                        <MenuFlyout Placement="Top">
                            <MenuFlyoutItem x:Uid="SocialChatAttachFromPcItem" Click="AttachFromPcItem_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7F8;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="SocialChatAttachFromDriveItem" Click="AttachFromDriveItem_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE753;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <Button x:Uid="SocialChatEmojiButton" x:Name="EmojiButton"
                        Grid.Row="1"
                        Grid.Column="2"
                        Style="{StaticResource SocialToolButtonStyle}"
                        VerticalAlignment="Bottom">
                    <FontIcon Glyph="&#xE76E;" FontSize="16" IsTextScaleFactorEnabled="False"/>
                    <Button.Flyout>
                        <Flyout x:Name="EmojiFlyout" Opening="EmojiFlyout_Opening"/>
                    </Button.Flyout>
                </Button>

                <local:SocialCharacterRing x:Name="Ring"
                                           Grid.Row="1"
                                           Grid.Column="3"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>

                <Button x:Uid="SocialChatSendButton" x:Name="SendButton"
                        Grid.Row="1"
                        Grid.Column="4"
                        Style="{StaticResource AccentButtonStyle}"
                        Width="40" Height="32"
                        MinWidth="40"
                        Padding="0"
                        contract7Present:CornerRadius="0"
                        VerticalAlignment="Bottom"
                        IsEnabled="False"
                        Click="SendButton_Click">
                    <FontIcon Glyph="&#xE724;" FontSize="16" IsTextScaleFactorEnabled="False"/>
                </Button>
            </Grid>
        </Grid>
    </SplitView>
</UserControl>
