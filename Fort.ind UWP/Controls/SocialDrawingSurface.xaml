<UserControl
    x:Class="Fort.ind_UWP.SocialDrawingSurface"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fort.ind_UWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <InkToolbar x:Name="Toolbar"
                    TargetInkCanvas="{x:Bind Ink}"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    ActiveToolChanged="Toolbar_ActiveToolChanged">
            <InkToolbarCustomToolButton x:Uid="InkDrawSelectionTool" x:Name="LassoButton">
                <FontIcon Glyph="&#xEF20;"/>
            </InkToolbarCustomToolButton>
        </InkToolbar>

        <Viewbox x:Name="PaperBox"
                 Grid.Row="1"
                 Stretch="Uniform"
                 StretchDirection="Both">
            <Grid x:Name="Paper" Width="800" Height="600">
                <Border x:Name="PaperBackground" Background="White"/>
                <Image x:Name="Photo" Stretch="Fill"/>
                <InkCanvas x:Name="Ink"/>
                <Canvas x:Name="SelectionLayer" IsHitTestVisible="False"/>
                <Border x:Name="PaperEdge"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                        IsHitTestVisible="False"/>
            </Grid>
        </Viewbox>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="2" Margin="-10,0,0,0">
                <Button x:Uid="InkDrawUndo"
                        x:Name="UndoButton"
                        Style="{StaticResource SocialToolButtonStyle}"
                        IsEnabled="False"
                        Click="UndoButton_Click">
                    <FontIcon Glyph="&#xE7A7;" FontSize="16" IsTextScaleFactorEnabled="False"/>
                </Button>
                <Button x:Uid="InkDrawRedo"
                        x:Name="RedoButton"
                        Style="{StaticResource SocialToolButtonStyle}"
                        IsEnabled="False"
                        Click="RedoButton_Click">
                    <FontIcon Glyph="&#xE7A6;" FontSize="16" IsTextScaleFactorEnabled="False"/>
                </Button>
                <Button x:Uid="InkDrawMore"
                        x:Name="MoreButton"
                        Style="{StaticResource SocialToolButtonStyle}">
                    <FontIcon Glyph="&#xE712;" FontSize="16" IsTextScaleFactorEnabled="False"/>
                    <Button.Flyout>
                        <MenuFlyout x:Name="MoreMenu">
                            <MenuFlyoutSubItem x:Uid="InkDrawBackgroundMenu" x:Name="BackgroundMenu">
                                <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE790;"/></MenuFlyoutSubItem.Icon>
                                <ToggleMenuFlyoutItem x:Uid="InkDrawBackgroundWhite" x:Name="WhiteItem" Tag="White" Click="BackgroundItem_Click"/>
                                <ToggleMenuFlyoutItem x:Uid="InkDrawBackgroundBlack" x:Name="BlackItem" Tag="Black" Click="BackgroundItem_Click"/>
                                <ToggleMenuFlyoutItem x:Uid="InkDrawBackgroundTint" x:Name="TintItem" Tag="Tint" Click="BackgroundItem_Click"/>
                                <ToggleMenuFlyoutItem x:Uid="InkDrawBackgroundTransparent" x:Name="TransparentItem" Tag="Transparent" Click="BackgroundItem_Click"/>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem x:Uid="InkDrawAspectMenu" x:Name="AspectMenu">
                                <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE799;"/></MenuFlyoutSubItem.Icon>
                                <ToggleMenuFlyoutItem x:Uid="InkDrawAspectLandscape" x:Name="LandscapeItem" Tag="Landscape" Click="AspectItem_Click"/>
                                <ToggleMenuFlyoutItem x:Uid="InkDrawAspectWide" x:Name="WideItem" Tag="Wide" Click="AspectItem_Click"/>
                                <ToggleMenuFlyoutItem x:Uid="InkDrawAspectSquare" x:Name="SquareItem" Tag="Square" Click="AspectItem_Click"/>
                                <ToggleMenuFlyoutItem x:Uid="InkDrawAspectPortrait" x:Name="PortraitItem" Tag="Portrait" Click="AspectItem_Click"/>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator x:Name="MoreSeparator"/>
                            <MenuFlyoutItem x:Uid="InkDrawClearAll" x:Name="ClearAllItem" Click="ClearAllItem_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <Button x:Uid="InkDrawCancel"
                    x:Name="CancelButton"
                    Grid.Column="1"
                    MinWidth="88"
                    Click="CancelButton_Click"/>

            <Button x:Name="AttachButton"
                    Grid.Column="2"
                    Style="{StaticResource AccentButtonStyle}"
                    MinWidth="88"
                    IsEnabled="False"
                    Click="AttachButton_Click">
                <Grid>
                    <TextBlock x:Name="AttachLabel" HorizontalAlignment="Center"/>
                    <ProgressRing x:Name="AttachRing" Width="16" Height="16" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" Visibility="Collapsed"/>
                </Grid>
            </Button>
        </Grid>
    </Grid>
</UserControl>
