<UserControl
    x:Class="Fort.ind_UWP.SocialMediaLightbox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fort.ind_UWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    TabFocusNavigation="Cycle"
    KeyboardAcceleratorPlacementMode="Hidden">

    <Grid>
        <Border x:Name="Scrim"
                Background="{ThemeResource SocialLightboxScrimBrush}"
                Opacity="0"
                Tapped="Scrim_Tapped"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleBarRow" Height="0"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="TopBar"
                  Grid.Row="1"
                  Padding="24,8,12,8"
                  ColumnSpacing="12"
                  Opacity="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="PositionText"
                           VerticalAlignment="Center"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                           TextWrapping="NoWrap"/>

                <Button x:Uid="SocialLightboxCloseButton"
                        x:Name="CloseButton"
                        Grid.Column="1"
                        Style="{StaticResource ButtonRevealStyle}"
                        Width="40" Height="40"
                        MinWidth="40" MinHeight="40"
                        Padding="0"
                        CornerRadius="0"
                        Click="CloseButton_Click">
                    <FontIcon Glyph="&#xE711;" FontSize="16" IsTextScaleFactorEnabled="False"/>
                </Button>
            </Grid>

            <FlipView x:Uid="SocialLightboxFlipView"
                      x:Name="MediaFlipView"
                      Grid.Row="2"
                      Background="Transparent"
                      SelectionChanged="MediaFlipView_SelectionChanged"/>

            <ScrollViewer x:Name="CaptionScroller"
                          Grid.Row="3"
                          MaxHeight="160"
                          Opacity="0"
                          HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="CaptionText"
                           MaxWidth="720"
                           Margin="24,12,24,16"
                           HorizontalAlignment="Center"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="True"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
