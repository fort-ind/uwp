<UserControl
    x:Class="Fort.ind_UWP.SocialUserRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fort.ind_UWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalAlignment="Stretch">

    <UserControl.Resources>
        <Style x:Key="FollowAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}"/>
    </UserControl.Resources>

    <Grid Padding="12,10"
          ColumnSpacing="12"
          BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
          BorderThickness="0,0,0,1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <PersonPicture x:Name="AvatarPicture"
                       Width="40" Height="40"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       AutomationProperties.AccessibilityView="Raw"/>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <RichTextBlock x:Name="NameText"
                           Style="{StaticResource BaseRichTextBlockStyle}"
                           IsTextSelectionEnabled="False"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1"/>
            <TextBlock x:Name="HandleText"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1"/>
            <TextBlock x:Name="DetailText"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1"
                       Visibility="Collapsed"/>
        </StackPanel>

        <Button x:Name="FollowButton"
                Grid.Column="2"
                MinWidth="96"
                VerticalAlignment="Center"
                Visibility="Collapsed"
                Click="FollowButton_Click">
            <TextBlock x:Name="FollowText"/>
        </Button>

        <StackPanel x:Name="RequestPanel"
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
            <Button x:Uid="SocialFollowRequestAcceptButton"
                    x:Name="AcceptButton"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="AcceptButton_Click"/>
            <Button x:Uid="SocialFollowRequestRejectButton"
                    x:Name="RejectButton"
                    Click="RejectButton_Click"/>
        </StackPanel>

        <Button x:Name="ModerationButton"
                Grid.Column="2"
                MinWidth="96"
                VerticalAlignment="Center"
                Visibility="Collapsed"
                Click="ModerationButton_Click"/>

        <StackPanel x:Name="ModerationOutcomePanel"
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
            <TextBlock x:Name="ModerationOutcomeText"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
            <HyperlinkButton x:Uid="SocialModerationUndoLink"
                             x:Name="ModerationUndoLink"
                             VerticalAlignment="Center"
                             Click="ModerationUndoLink_Click"/>
        </StackPanel>

        <TextBlock x:Name="RequestOutcomeText"
                   Grid.Column="2"
                   VerticalAlignment="Center"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                   Visibility="Collapsed"/>
    </Grid>
</UserControl>
