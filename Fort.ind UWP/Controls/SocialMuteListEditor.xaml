<UserControl
    x:Class="Fort.ind_UWP.SocialMuteListEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fort.ind_UWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalAlignment="Stretch">

    <StackPanel>
        <TextBlock x:Name="HeaderText"
                   Style="{StaticResource BodyTextBlockStyle}"
                   FontWeight="SemiBold"
                   AutomationProperties.HeadingLevel="Level3"/>
        <TextBlock x:Name="DescriptionText"
                   Margin="0,4,0,0"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
        <TextBox x:Name="Box"
                 Margin="0,8,0,0"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="96"
                 MaxHeight="240"
                 IsSpellCheckEnabled="False"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 TextChanged="Box_TextChanged"/>
        <TextBlock x:Name="ErrorText"
                   Margin="0,4,0,0"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}"
                   Visibility="Collapsed"
                   AutomationProperties.LiveSetting="Polite"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Uid="MuteEditorSaveButton"
                    x:Name="SaveButton"
                    IsEnabled="False"
                    Click="SaveButton_Click"/>
            <Button x:Uid="MuteEditorRevertButton"
                    x:Name="RevertButton"
                    Margin="8,0,0,0"
                    IsEnabled="False"
                    Click="RevertButton_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>
