<UserControl
    x:Class="Fort.ind_UWP.SocialChatRoomPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fort.ind_UWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:contract7Present="http://schemas.microsoft.com/winfx/2006/xaml/presentation?IsApiContractPresent(Windows.Foundation.UniversalApiContract,7)"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="SocialChatMemberTemplate" x:DataType="local:SocialChatMemberItem">
            <Grid Padding="0,6,0,6" ColumnSpacing="12" AutomationProperties.Name="{x:Bind AutomationName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <PersonPicture Width="32" Height="32"
                               VerticalAlignment="Center"
                               DisplayName="{x:Bind PlainName}"
                               ProfilePicture="{x:Bind Avatar}"
                               AutomationProperties.AccessibilityView="Raw"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind PlainName}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.AccessibilityView="Raw"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Bind Handle}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock x:Uid="SocialChatRoomOwnerTag"
                                   Margin="8,0,0,0"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                   Visibility="{x:Bind OwnerVisibility}"
                                   AutomationProperties.AccessibilityView="Raw"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SocialChatInviteSuggestionTemplate" x:DataType="local:SocialUser">
            <StackPanel Padding="0,4,0,4">
                <TextBlock Text="{x:Bind DisplayName}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{x:Bind Handle}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="SocialChatMemberContainerStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="16,0,16,0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid"
          BorderBrush="{ThemeResource CardBorderBrush}"
          BorderThickness="1,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Padding="16,8,8,8"
              ColumnSpacing="8"
              BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="SocialChatRoomInfoHeader"
                       VerticalAlignment="Center"
                       Style="{StaticResource BaseTextBlockStyle}"
                       AutomationProperties.HeadingLevel="Level2"/>
            <Button x:Uid="SocialChatRoomInfoCloseButton" x:Name="CloseButton"
                    Grid.Column="1"
                    Style="{StaticResource ButtonRevealStyle}"
                    Background="Transparent"
                    Width="40" Height="40"
                    MinWidth="40" MinHeight="40"
                    Padding="0"
                    contract7Present:CornerRadius="0"
                    VerticalAlignment="Center"
                    Click="CloseButton_Click">
                <FontIcon Glyph="&#xE711;" FontSize="16" IsTextScaleFactorEnabled="False"/>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled">
            <StackPanel Padding="0,12,0,16">
                <StackPanel x:Name="DetailsPanel" Margin="16,0,16,0">
                    <TextBlock x:Name="NameText"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True"/>
                    <TextBlock x:Name="DescriptionText"
                               Margin="0,4,0,0"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="OwnerText"
                               Margin="0,8,0,0"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                               TextWrapping="Wrap"/>
                    <Button x:Uid="SocialChatRoomEditButton" x:Name="EditButton"
                            Margin="0,12,0,0"
                            Visibility="Collapsed"
                            Click="EditButton_Click"/>
                </StackPanel>

                <StackPanel x:Name="EditPanel" Margin="16,0,16,0" Visibility="Collapsed">
                    <TextBox x:Uid="SocialChatRoomNameBox" x:Name="NameBox"
                             MaxLength="256"
                             TextChanged="NameBox_TextChanged"/>
                    <TextBox x:Uid="SocialChatRoomDescriptionBox" x:Name="DescriptionBox"
                             Margin="0,12,0,0"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MaxLength="1024"
                             MinHeight="80"
                             MaxHeight="200"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <Button x:Uid="SocialChatRoomSaveButton" x:Name="SaveButton"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="SaveButton_Click"/>
                        <Button x:Uid="SocialChatRoomCancelEditButton" x:Name="CancelEditButton"
                                Margin="8,0,0,0"
                                Click="CancelEditButton_Click"/>
                    </StackPanel>
                </StackPanel>

                <ToggleSwitch x:Uid="SocialChatRoomMuteToggle" x:Name="MuteToggle"
                              Margin="16,20,16,0"
                              Visibility="Collapsed"
                              Toggled="MuteToggle_Toggled"/>

                <TextBlock x:Name="MembersHeading"
                           Margin="16,24,16,8"
                           Style="{StaticResource BaseTextBlockStyle}"
                           AutomationProperties.HeadingLevel="Level3"/>

                <StackPanel x:Name="InvitePanel" Margin="16,0,16,8" Visibility="Collapsed">
                    <AutoSuggestBox x:Uid="SocialChatRoomInviteSearch" x:Name="InviteSearch"
                                    QueryIcon="Find"
                                    UpdateTextOnSelect="False"
                                    ItemTemplate="{StaticResource SocialChatInviteSuggestionTemplate}"
                                    TextChanged="InviteSearch_TextChanged"
                                    QuerySubmitted="InviteSearch_QuerySubmitted"/>
                    <TextBlock x:Name="InviteStatus"
                               Margin="0,6,0,0"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>

                <TextBlock x:Name="FullText"
                           Margin="16,0,16,8"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>

                <ListView x:Uid="SocialChatRoomMemberList" x:Name="MemberList"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemTemplate="{StaticResource SocialChatMemberTemplate}"
                          ItemContainerStyle="{StaticResource SocialChatMemberContainerStyle}"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ItemClick="MemberList_ItemClick"/>

                <local:SocialLoadingIndicator x:Uid="SocialChatRoomMembersLoading" x:Name="MembersLoading"
                                              Margin="0,8,0,8"
                                              HorizontalAlignment="Center"
                                              IsActive="False"
                                              Visibility="Collapsed"/>

                <TextBlock x:Name="MembersStatus"
                           Margin="16,0,16,0"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           AutomationProperties.LiveSetting="Polite"/>

                <Button x:Uid="SocialChatRoomLeaveButton" x:Name="LeaveButton"
                        Margin="16,24,16,0"
                        Visibility="Collapsed"
                        Click="LeaveButton_Click"/>
                <Button x:Uid="SocialChatRoomDeleteButton" x:Name="DeleteButton"
                        Margin="16,24,16,0"
                        Visibility="Collapsed"
                        Click="DeleteButton_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
