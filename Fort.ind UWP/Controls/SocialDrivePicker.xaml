<UserControl
    x:Class="Fort.ind_UWP.SocialDrivePicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fort.ind_UWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="UserControl_Loaded"
    Unloaded="UserControl_Unloaded">

    <Grid Width="460">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="-10,0,0,8" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Uid="SocialDriveBackButton"
                    x:Name="BackButton"
                    Style="{StaticResource SocialToolButtonStyle}"
                    IsEnabled="False"
                    Click="BackButton_Click">
                <FontIcon Glyph="&#xE72B;" FontSize="16" IsTextScaleFactorEnabled="False"/>
            </Button>
            <TextBlock x:Name="PathText"
                       Grid.Column="1"
                       Style="{StaticResource BaseTextBlockStyle}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"/>
        </Grid>

        <ScrollViewer x:Name="FolderScroller"
                      Grid.Row="1"
                      MaxHeight="88"
                      Margin="0,0,0,8"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="Collapsed">
            <ItemsControl x:Uid="SocialDriveFolders"
                          x:Name="FolderList"
                          IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <local:TagWrapPanel HorizontalSpacing="8" VerticalSpacing="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:SocialDriveFolder">
                        <Button CornerRadius="0"
                                MaxWidth="220"
                                AutomationProperties.Name="{x:Bind AutomationName}"
                                ToolTipService.ToolTip="{x:Bind Name}"
                                Click="Folder_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B7;" FontSize="16" IsTextScaleFactorEnabled="False"/>
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="2" Height="300">
            <GridView x:Uid="SocialDriveFiles"
                      x:Name="FileGrid"
                      SelectionMode="Multiple"
                      IsItemClickEnabled="False"
                      SelectionChanged="FileGrid_SelectionChanged"
                      ContainerContentChanging="FileGrid_ContainerContentChanging">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:SocialDrivePickerItem">
                        <Grid Width="88"
                              Height="88"
                              Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                              AutomationProperties.Name="{x:Bind AutomationName}"
                              ToolTipService.ToolTip="{x:Bind Name}">
                            <StackPanel VerticalAlignment="Center" Margin="6,0">
                                <FontIcon Glyph="{x:Bind KindGlyph}" FontSize="24" IsTextScaleFactorEnabled="False"/>
                                <TextBlock Text="{x:Bind Name}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Margin="0,6,0,0"
                                           HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           Visibility="{x:Bind local:SocialComposer.Shown(ShowsName)}"/>
                            </StackPanel>
                            <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill"/>
                            <Border Background="#99000000"
                                    Width="28" Height="28"
                                    Visibility="{x:Bind local:SocialComposer.Shown(IsVideo)}">
                                <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="White" IsTextScaleFactorEnabled="False"/>
                            </Border>
                            <Border Background="#99000000"
                                    Padding="4"
                                    Margin="4"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Visibility="{x:Bind local:SocialComposer.Shown(IsSensitive)}">
                                <FontIcon Glyph="&#xE7B3;" FontSize="12" Foreground="White" IsTextScaleFactorEnabled="False"/>
                            </Border>
                            <Grid Background="#99000000"
                                  Visibility="{x:Bind local:SocialComposer.Shown(IsAttached)}">
                                <StackPanel VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="White" IsTextScaleFactorEnabled="False"/>
                                    <TextBlock x:Uid="SocialDriveAttachedBadge"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="White"
                                               Margin="0,4,0,0"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
                <GridView.Footer>
                    <Button x:Uid="SocialDriveLoadMore"
                            x:Name="LoadMoreButton"
                            CornerRadius="0"
                            Margin="0,4,0,8"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed"
                            Click="LoadMoreButton_Click"/>
                </GridView.Footer>
            </GridView>

            <ProgressRing x:Name="LoadingRing"
                          Width="32"
                          Height="32"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>

            <StackPanel x:Name="StatusPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="360"
                        Visibility="Collapsed">
                <TextBlock x:Name="StatusText"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
                <Button x:Uid="SocialDriveRetry"
                        x:Name="RetryButton"
                        CornerRadius="0"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        Click="RetryButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
