<UserControl
    x:Class="Fort.ind_UWP.SocialComposer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fort.ind_UWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    AllowDrop="True">

    <Grid x:Name="RootGrid" ColumnSpacing="12" RowSpacing="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="BodyRow" Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <PersonPicture x:Name="AvatarPicture"
                       Width="40" Height="40"
                       VerticalAlignment="Top"
                       Margin="0,4,0,0"
                       AutomationProperties.AccessibilityView="Raw"/>

        <ScrollViewer x:Name="BodyScroller"
                      Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled"
                      Padding="0,0,4,0">
            <StackPanel x:Name="BodyPanel" Padding="0,4,0,0">
                <DropDownButton x:Uid="SocialComposeVisibilityButton"
                                x:Name="VisibilityButton"
                                Margin="0,0,0,8"
                                Padding="10,4,10,4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="VisibilityGlyph" FontSize="14" IsTextScaleFactorEnabled="False"/>
                        <TextBlock x:Name="VisibilityLabel"/>
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="VisibilityMenu" Placement="BottomEdgeAlignedLeft">
                            <ToggleMenuFlyoutItem x:Uid="SocialComposeVisibilityPublic" x:Name="PublicItem" Tag="public" Click="VisibilityItem_Click">
                                <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE774;"/></ToggleMenuFlyoutItem.Icon>
                            </ToggleMenuFlyoutItem>
                            <ToggleMenuFlyoutItem x:Uid="SocialComposeVisibilityHome" x:Name="HomeItem" Tag="home" Click="VisibilityItem_Click">
                                <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE80F;"/></ToggleMenuFlyoutItem.Icon>
                            </ToggleMenuFlyoutItem>
                            <ToggleMenuFlyoutItem x:Uid="SocialComposeVisibilityFollowers" x:Name="FollowersItem" Tag="followers" Click="VisibilityItem_Click">
                                <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE72E;"/></ToggleMenuFlyoutItem.Icon>
                            </ToggleMenuFlyoutItem>
                            <ToggleMenuFlyoutItem x:Uid="SocialComposeVisibilityDirect" x:Name="DirectItem" Tag="specified" Click="VisibilityItem_Click">
                                <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE715;"/></ToggleMenuFlyoutItem.Icon>
                            </ToggleMenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <ToggleMenuFlyoutItem x:Uid="SocialComposeLocalOnly" x:Name="LocalOnlyItem" Click="LocalOnlyItem_Click">
                                <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE909;"/></ToggleMenuFlyoutItem.Icon>
                            </ToggleMenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <local:SocialRecipientBox x:Name="RecipientBox"
                                          Margin="0,0,0,8"
                                          Visibility="Collapsed"
                                          Changed="RecipientBox_Changed"/>

                <TextBox x:Uid="SocialComposeWarningBox"
                         x:Name="WarningBox"
                         Margin="0,0,0,8"
                         MaxLength="500"
                         TextWrapping="Wrap"
                         IsSpellCheckEnabled="True"
                         Visibility="Collapsed"
                         TextChanged="Field_TextChanged"/>

                <TextBox x:Uid="SocialComposeEditor"
                         x:Name="Editor"
                         Margin="0,0,0,8"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         IsSpellCheckEnabled="True"
                         MinHeight="140"
                         TextChanged="Editor_TextChanged"
                         SelectionChanged="Editor_SelectionChanged"
                         PreviewKeyDown="Editor_PreviewKeyDown"
                         Paste="Editor_Paste"
                         GotFocus="Editor_GotFocus"
                         LostFocus="Editor_LostFocus"/>

                <Border x:Name="PreviewHost"
                        Margin="0,0,0,8"
                        Visibility="Collapsed"
                        Padding="12,8,12,10"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="SocialComposePreviewHeader"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        <TextBlock x:Name="PreviewWarning"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   FontStyle="Italic"
                                   Visibility="Collapsed"/>
                        <RichTextBlock x:Name="PreviewText"
                                       Style="{StaticResource BodyRichTextBlockStyle}"
                                       IsTextSelectionEnabled="False"
                                       TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Grid x:Name="QuoteCard"
                      Margin="0,0,0,8"
                      Visibility="Collapsed"
                      Padding="10,8,4,8"
                      ColumnSpacing="8"
                      BorderThickness="1"
                      BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="QuoteHeader"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="QuoteExcerpt"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   MaxLines="3"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Uid="SocialComposeRemoveQuote"
                            x:Name="RemoveQuoteButton"
                            Grid.Column="1"
                            Style="{StaticResource SocialActionButtonStyle}"
                            Width="40" Padding="0"
                            VerticalAlignment="Top"
                            Click="RemoveQuoteButton_Click">
                        <FontIcon Glyph="&#xE711;" FontSize="12" IsTextScaleFactorEnabled="False"/>
                    </Button>
                </Grid>

                <ItemsControl x:Uid="SocialComposeAttachments"
                              x:Name="AttachmentList"
                              Margin="0,0,0,8"
                              Visibility="Collapsed"
                              IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <local:TagWrapPanel HorizontalSpacing="8" VerticalSpacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:SocialAttachmentItem">
                            <Grid Width="88" Height="88">
                                <Button Style="{StaticResource SocialBareButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind Name}"
                                        Click="AttachmentTile_Click">
                                    <Grid Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                                        <FontIcon Glyph="&#xE723;" FontSize="24" IsTextScaleFactorEnabled="False"/>
                                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill"/>
                                        <Grid Background="#99000000"
                                              Visibility="{x:Bind local:SocialComposer.Shown(HasError), Mode=OneWay}">
                                            <FontIcon Glyph="&#xE7BA;" FontSize="20" Foreground="White" IsTextScaleFactorEnabled="False"/>
                                        </Grid>
                                        <ProgressBar Value="{x:Bind Progress, Mode=OneWay}"
                                                     Maximum="1"
                                                     VerticalAlignment="Bottom"
                                                     Margin="6"
                                                     Visibility="{x:Bind local:SocialComposer.Shown(IsUploading), Mode=OneWay}"/>
                                        <Border Background="#99000000"
                                                Padding="5,1,5,2"
                                                Margin="4"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Bottom"
                                                Visibility="{x:Bind local:SocialComposer.Shown(HasDescription), Mode=OneWay}">
                                            <TextBlock x:Uid="SocialComposeAltBadge" Style="{StaticResource CaptionTextBlockStyle}" Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </Button>
                                <Button x:Uid="SocialComposeRemoveAttachment"
                                        Width="28" Height="28"
                                        MinWidth="0" MinHeight="0"
                                        Padding="0"
                                        Margin="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="#99000000"
                                        Foreground="White"
                                        Click="RemoveAttachment_Click">
                                    <FontIcon Glyph="&#xE711;" FontSize="10" IsTextScaleFactorEnabled="False"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel x:Name="PollPanel" Spacing="6" Margin="0,0,0,8" Visibility="Collapsed">
                    <TextBlock x:Uid="SocialComposePollHeader"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                    <StackPanel x:Name="PollChoices" Spacing="6"/>
                    <Button x:Uid="SocialComposePollAddChoice"
                            x:Name="AddChoiceButton"
                            Style="{StaticResource TextBlockButtonStyle}"
                            Padding="0,4,0,4"
                            Click="AddChoiceButton_Click"/>
                    <CheckBox x:Uid="SocialComposePollMultiple"
                              x:Name="MultipleBox"
                              Checked="PollField_Changed"
                              Unchecked="PollField_Changed"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Uid="SocialComposePollEnds"
                                  x:Name="ExpiryBox"
                                  MinWidth="160"
                                  SelectionChanged="ExpiryBox_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel x:Name="CustomExpiryPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                        <DatePicker x:Uid="SocialComposePollEndDate"
                                    x:Name="ExpiryDate"
                                    DateChanged="ExpiryDate_DateChanged"/>
                        <TimePicker x:Uid="SocialComposePollEndTime"
                                    x:Name="ExpiryTime"
                                    TimeChanged="ExpiryTime_TimeChanged"/>
                    </StackPanel>
                    <TextBlock x:Uid="SocialComposePollResetWarning"
                               x:Name="PollResetWarning"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="Toolbar"
              Grid.Row="1"
              Grid.ColumnSpan="2"
              ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="ToolButtons" Orientation="Horizontal" Spacing="2" Margin="-10,0,0,0">
                <Button x:Uid="SocialComposeEmojiButton"
                        x:Name="EmojiButton"
                        Style="{StaticResource SocialActionButtonStyle}"
                        Width="40" Padding="0">
                    <FontIcon Glyph="&#xE76E;" FontSize="16" IsTextScaleFactorEnabled="False"/>
                    <Button.Flyout>
                        <Flyout x:Name="EmojiFlyout" Opening="EmojiFlyout_Opening"/>
                    </Button.Flyout>
                </Button>
                <ToggleButton x:Uid="SocialComposeWarningButton"
                              x:Name="WarningToggle"
                              Background="Transparent"
                              BorderThickness="0"
                              Width="40" Height="40" Padding="0"
                              Click="WarningToggle_Click">
                    <FontIcon Glyph="&#xE7BA;" FontSize="16" IsTextScaleFactorEnabled="False"/>
                </ToggleButton>
                <Button x:Uid="SocialComposeAttachButton"
                        x:Name="AttachButton"
                        Style="{StaticResource SocialActionButtonStyle}"
                        Width="40" Padding="0"
                        Click="AttachButton_Click">
                    <FontIcon Glyph="&#xE723;" FontSize="16" IsTextScaleFactorEnabled="False"/>
                </Button>
                <ToggleButton x:Uid="SocialComposePollButton"
                              x:Name="PollToggle"
                              Background="Transparent"
                              BorderThickness="0"
                              Width="40" Height="40" Padding="0"
                              Click="PollToggle_Click">
                    <FontIcon Glyph="&#xE8FD;" FontSize="16" IsTextScaleFactorEnabled="False"/>
                </ToggleButton>
                <ToggleButton x:Uid="SocialComposePreviewButton"
                              x:Name="PreviewToggle"
                              Background="Transparent"
                              BorderThickness="0"
                              Width="40" Height="40" Padding="0"
                              Click="PreviewToggle_Click">
                    <FontIcon Glyph="&#xE890;" FontSize="16" IsTextScaleFactorEnabled="False"/>
                </ToggleButton>
                <Button x:Uid="SocialComposeMoreButton"
                        x:Name="MoreButton"
                        Style="{StaticResource SocialActionButtonStyle}"
                        Width="40" Padding="0">
                    <FontIcon Glyph="&#xE712;" FontSize="16" IsTextScaleFactorEnabled="False"/>
                    <Button.Flyout>
                        <MenuFlyout x:Name="MoreMenu">
                            <MenuFlyoutSubItem x:Uid="SocialComposeReactionsMenu">
                                <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xEB51;"/></MenuFlyoutSubItem.Icon>
                                <ToggleMenuFlyoutItem x:Uid="SocialComposeReactionsAll" x:Name="AcceptAllItem" Tag="" Click="AcceptanceItem_Click"/>
                                <ToggleMenuFlyoutItem x:Uid="SocialComposeReactionsLikeOnly" x:Name="AcceptLikeOnlyItem" Tag="likeOnly" Click="AcceptanceItem_Click"/>
                                <ToggleMenuFlyoutItem x:Uid="SocialComposeReactionsLikeOnlyRemote" x:Name="AcceptLikeOnlyRemoteItem" Tag="likeOnlyForRemote" Click="AcceptanceItem_Click"/>
                                <ToggleMenuFlyoutItem x:Uid="SocialComposeReactionsNonSensitive" x:Name="AcceptNonSensitiveItem" Tag="nonSensitiveOnly" Click="AcceptanceItem_Click"/>
                                <ToggleMenuFlyoutItem x:Uid="SocialComposeReactionsNonSensitiveLikeRemote" x:Name="AcceptNonSensitiveRemoteItem" Tag="nonSensitiveOnlyForLocalLikeOnlyForRemote" Click="AcceptanceItem_Click"/>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem x:Uid="SocialComposeDiscard" x:Name="DiscardItem" Click="DiscardItem_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <FontIcon x:Name="ReplyVisibilityGlyph"
                          FontSize="14"
                          Margin="10,0,0,0"
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                          IsTextScaleFactorEnabled="False"
                          Visibility="Collapsed"/>
            </StackPanel>

            <local:SocialCharacterRing x:Name="Ring" Grid.Column="1"/>

            <Button x:Name="PostButton"
                    Grid.Column="2"
                    Style="{StaticResource AccentButtonStyle}"
                    MinWidth="88"
                    IsEnabled="False"
                    Click="PostButton_Click">
                <Grid>
                    <TextBlock x:Name="PostLabel" HorizontalAlignment="Center"/>
                    <ProgressRing x:Name="PostRing" Width="16" Height="16" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" Visibility="Collapsed"/>
                </Grid>
            </Button>
        </Grid>

        <Popup x:Name="SuggestionPopup"
               Grid.ColumnSpan="2"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               IsLightDismissEnabled="False">
            <Border Background="{ThemeResource SystemControlTransientBackgroundBrush}"
                    BorderBrush="{ThemeResource SystemControlTransientBorderBrush}"
                    BorderThickness="{ThemeResource FlyoutBorderThemeThickness}"
                    Width="280">
                <ListView x:Uid="SocialComposeSuggestions"
                          x:Name="SuggestionList"
                          MaxHeight="240"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="SuggestionList_ItemClick"
                          AllowFocusOnInteraction="False"
                          IsTabStop="False">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:SocialSuggestion">
                            <Grid ColumnSpacing="10" Padding="0,4,0,4" AutomationProperties.Name="{x:Bind AutomationName}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Glyph}"
                                           FontFamily="Segoe UI Emoji"
                                           FontSize="18"
                                           IsTextScaleFactorEnabled="False"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <Image Source="{x:Bind Image}" Width="24" Height="24" Stretch="Uniform"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind Detail}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{x:Bind local:SocialComposer.Shown(HasDetail)}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Popup>
    </Grid>
</UserControl>
