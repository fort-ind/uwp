<Page
    x:Class="Fort.ind_UWP.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fort.ind_UWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    mc:Ignorable="d"
    KeyboardAcceleratorPlacementMode="Hidden"
    Background="Transparent">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="FocusSearchAccelerator_Invoked"/>
        <KeyboardAccelerator Key="Escape" Invoked="ClearSearchAccelerator_Invoked"/>
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <DataTemplate x:Key="WelcomeDialogContentTemplate">
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="24"
                            Margin="0,8,0,8">
                    <FontIcon Glyph="&#xE734;" FontSize="32" AutomationProperties.AccessibilityView="Raw"/>
                    <FontIcon Glyph="&#xE9A1;" FontSize="32" AutomationProperties.AccessibilityView="Raw"/>
                    <FontIcon Glyph="&#xE774;" FontSize="32" AutomationProperties.AccessibilityView="Raw"/>
                </StackPanel>

                <TextBlock x:Uid="MainWelcomeToTheBeta"
                           Style="{StaticResource BodyTextBlockStyle}"
                           TextWrapping="Wrap"
                           Opacity="0.9"/>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="SettingsBreadcrumbButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,4,0,4"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="ContentPresenter"
                                          Background="{TemplateBinding Background}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Padding="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTransitions="{TemplateBinding ContentTransitions}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          AutomationProperties.AccessibilityView="Raw">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource SystemControlDisabledBaseMediumLowBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </ContentPresenter>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ShellTitleHeaderTemplate">
            <TextBlock Text="{Binding}"
                       Style="{StaticResource TitleTextBlockStyle}"
                       AutomationProperties.HeadingLevel="Level1"
                       VerticalAlignment="Top"
                       TextTrimming="CharacterEllipsis"
                       Margin="12,0,12,0"/>
        </DataTemplate>

        <DataTemplate x:Key="SettingsBreadcrumbHeaderTemplate" x:DataType="local:SettingsCategory">
            <Grid Margin="12,0,12,0" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Uid="SettingsBreadcrumbHome"
                        Style="{StaticResource SettingsBreadcrumbButtonStyle}"
                        Margin="0,-4,0,-4"
                        VerticalAlignment="Top"
                        Click="SettingsBreadcrumb_Click">
                    <TextBlock x:Uid="SettingsBreadcrumbHomeText"
                               Style="{StaticResource TitleTextBlockStyle}"
                               TextWrapping="NoWrap"/>
                </Button>
                <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="16"
                          Margin="12,0,12,0" VerticalAlignment="Center"
                          Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                          AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock Grid.Column="2" Text="{x:Bind Title}"
                           Style="{StaticResource TitleTextBlockStyle}"
                           AutomationProperties.HeadingLevel="Level1"
                           VerticalAlignment="Top"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </DataTemplate>

        <local:ShellHeaderTemplateSelector x:Key="ShellHeaderTemplateSelector"
                                           TitleTemplate="{StaticResource ShellTitleHeaderTemplate}"
                                           SettingsBreadcrumbTemplate="{StaticResource SettingsBreadcrumbHeaderTemplate}"/>
    </Page.Resources>

    <i:Interaction.Behaviors>
        <local:WindowActivationStateBehavior ActiveStateName="WindowActiveState"
                                             InactiveStateName="WindowInactiveState"/>
    </i:Interaction.Behaviors>

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="UpdateInfoBar.Margin" Value="12,8,12,0"/>
                        <Setter Target="SocialPermissionInfoBar.Margin" Value="12,8,12,0"/>
                        <Setter Target="SocialWritePermissionInfoBar.Margin" Value="12,8,12,0"/>
                        <Setter Target="SocialAccountPermissionInfoBar.Margin" Value="12,8,12,0"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="641"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="UpdateInfoBar.Margin" Value="24,8,24,0"/>
                        <Setter Target="SocialPermissionInfoBar.Margin" Value="24,8,24,0"/>
                        <Setter Target="SocialWritePermissionInfoBar.Margin" Value="24,8,24,0"/>
                        <Setter Target="SocialAccountPermissionInfoBar.Margin" Value="24,8,24,0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="UpdateKindStates">
                <VisualState x:Name="RegularUpdateState"/>
                <VisualState x:Name="MajorUpdateState">
                    <VisualState.Setters>
                        <Setter Target="UpdateInfoBar.Background" Value="{ThemeResource MajorUpdateInfoBarBackgroundBrush}"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="WindowActivationStates">
                <VisualState x:Name="WindowActiveState"/>
                <VisualState x:Name="WindowInactiveState">
                    <VisualState.Setters>
                        <Setter Target="AppTitleText.Foreground" Value="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Border x:Name="HighContrastSurface"
                Background="{ThemeResource HighContrastWindowSurfaceBrush}"
                IsHitTestVisible="False"/>

        <Grid x:Name="AppTitleBar"
              Height="32"
              VerticalAlignment="Top"
              Canvas.ZIndex="1"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInset" Width="0"/>
                <ColumnDefinition x:Name="TitleBarBackButtonSpace" Width="48"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="TitleBarRightInset" Width="0"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Uid="AppTitleText" x:Name="AppTitleText"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumHighBrush}"/>
        </Grid>

        <Button x:Uid="TitleBarBackButton" x:Name="TitleBarBackButton"
                Style="{StaticResource NavigationBackButtonNormalStyle}"
                Width="48"
                Height="32"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Canvas.ZIndex="2"
                IsEnabled="False"
                Click="TitleBarBackButton_Click"/>

        <NavigationView x:Name="NavView"
                         PaneDisplayMode="Auto"
                         CompactPaneLength="48"
                         OpenPaneLength="320"
                         IsBackButtonVisible="Collapsed"
                         IsSettingsVisible="True"
                         IsPaneToggleButtonVisible="True"
                         ItemInvoked="NavView_ItemInvoked"
                         Loaded="NavView_Loaded"
                         DisplayModeChanged="NavView_DisplayModeChanged"
                         PaneOpening="NavView_PaneOpening"
                         PaneClosing="NavView_PaneClosing"
                         Background="Transparent">

            <NavigationView.Resources>
                <x:Double x:Key="NavigationViewCompactPaneLength">48</x:Double>
                <x:Double x:Key="PaneToggleButtonWidth">48</x:Double>
                <Thickness x:Key="NavigationViewItemIconBoxMargin">16,12,16,12</Thickness>
            </NavigationView.Resources>

            <NavigationView.HeaderTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding}"
                                    ContentTemplateSelector="{StaticResource ShellHeaderTemplateSelector}"
                                    HorizontalContentAlignment="Stretch"
                                    HorizontalAlignment="Stretch"
                                    IsTabStop="False"/>
                </DataTemplate>
            </NavigationView.HeaderTemplate>

            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Uid="NavSearchBox" x:Name="NavSearchBox"
                                QueryIcon="Find"
                                AutomationProperties.LandmarkType="Search"
                                MaxSuggestionListHeight="400"
                                TextChanged="NavSearchBox_TextChanged"
                                QuerySubmitted="NavSearchBox_QuerySubmitted"
                                SuggestionChosen="NavSearchBox_SuggestionChosen">
                    <i:Interaction.Behaviors>
                        <local:PenHandwritingBehavior x:Name="NavSearchInk" WriteOnBox="True"/>
                    </i:Interaction.Behaviors>
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="local:SearchItem">
                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,4">
                                <FontIcon Glyph="{x:Bind Icon}"
                                          FontSize="16"
                                          VerticalAlignment="Center"
                                          Opacity="0.8"
                                          AutomationProperties.AccessibilityView="Raw"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}"/>
                                    <TextBlock Text="{x:Bind Category}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </NavigationView.AutoSuggestBox>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="MainHome" Tag="LatestNews"
                                     AccessKey="H">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainGames" Tag="Games"
                                     AccessKey="G">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7FC;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainBetaPrograms" Tag="Betas"
                                     AccessKey="B">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="PreviewLink"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="ProfileNavItem" x:Name="ProfileNavItem" Tag="Profile"
                                     AccessKey="P">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Contact"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainSocial" Tag="Social"
                                     AccessKey="S">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="People"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid x:Name="ContentHost" Background="Transparent"
                  AutomationProperties.LandmarkType="Main">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <muxc:InfoBar x:Uid="SocialPermissionInfoBar" x:Name="SocialPermissionInfoBar"
                                  Margin="24,8,24,0"
                                  Severity="Warning"
                                  IsOpen="False"
                                  IsClosable="True"
                                  CloseButtonClick="SocialPermissionInfoBar_CloseButtonClick">
                        <muxc:InfoBar.ActionButton>
                            <Button x:Uid="SocialPermissionSignInButton"
                                    Click="SocialPermissionSignInButton_Click"/>
                        </muxc:InfoBar.ActionButton>
                    </muxc:InfoBar>

                    <muxc:InfoBar x:Uid="SocialWritePermissionInfoBar" x:Name="SocialWritePermissionInfoBar"
                                  Margin="24,8,24,0"
                                  Severity="Informational"
                                  IsOpen="False"
                                  IsClosable="True"
                                  CloseButtonClick="SocialWritePermissionInfoBar_CloseButtonClick">
                        <muxc:InfoBar.ActionButton>
                            <Button x:Uid="SocialWritePermissionSignInButton"
                                    Click="SocialPermissionSignInButton_Click"/>
                        </muxc:InfoBar.ActionButton>
                    </muxc:InfoBar>

                    <muxc:InfoBar x:Uid="SocialAccountPermissionInfoBar" x:Name="SocialAccountPermissionInfoBar"
                                  Margin="24,8,24,0"
                                  Severity="Informational"
                                  IsOpen="False"
                                  IsClosable="True"
                                  CloseButtonClick="SocialAccountPermissionInfoBar_CloseButtonClick">
                        <muxc:InfoBar.ActionButton>
                            <Button x:Uid="SocialAccountPermissionSignInButton"
                                    Click="SocialPermissionSignInButton_Click"/>
                        </muxc:InfoBar.ActionButton>
                    </muxc:InfoBar>

                    <muxc:InfoBar x:Uid="UpdateInfoBar" x:Name="UpdateInfoBar"
                                  Margin="24,8,24,0"
                                  IsOpen="False"
                                  IsClosable="True"
                                  CloseButtonClick="UpdateInfoBar_CloseButtonClick">
                        <muxc:InfoBar.ActionButton>
                            <Button x:Uid="UpdateDownloadButton"
                                    Click="UpdateDownloadButton_Click"/>
                        </muxc:InfoBar.ActionButton>
                    </muxc:InfoBar>
                </StackPanel>

                <Frame x:Name="ContentFrame" Grid.Row="1"
                       Navigated="ContentFrame_Navigated"/>

                <ProgressBar x:Uid="SitemapLoadingBar" x:Name="LoadingIndicator"
                             Grid.Row="1"
                             IsIndeterminate="False"
                             Visibility="Collapsed"
                             VerticalAlignment="Top"
                             HorizontalAlignment="Stretch"
                             Canvas.ZIndex="1"/>

                <Border x:Name="AudioPlayerHost"
                        x:Load="False"
                        Grid.Row="2"
                        Visibility="Collapsed">
                    <local:SocialAudioBar x:Name="MiniPlayer" IsMini="True"/>
                </Border>
            </Grid>

        </NavigationView>

    </Grid>
</Page>
