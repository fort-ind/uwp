<Page
    x:Class="Fort.ind_UWP.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fort.ind_UWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    KeyboardAcceleratorPlacementMode="Hidden"
    Background="Transparent">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="FocusSearchAccelerator_Invoked"/>
        <KeyboardAccelerator Key="Escape" Invoked="ClearSearchAccelerator_Invoked"/>
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <CubicEase x:Key="PanelEnterEase" EasingMode="EaseOut"/>

        <!-- One favorited game on Home. The launch button and the star are siblings in a Grid, not
             nested, so neither swallows the other's input and each gets its own automation peer.
             The launch button takes its accessible name from its own content - the glyph beside the
             title is Raw, so what is left is the title. -->
        <DataTemplate x:Key="HomeFavoriteItemTemplate" x:DataType="local:SearchItem">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource ButtonRevealStyle}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="12,10"
                        CornerRadius="0"
                        Click="HomeFavoriteItem_Click">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{x:Bind Icon}"
                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   IsTextScaleFactorEnabled="False"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                   AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock Text="{x:Bind Title}"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Button>

                <ToggleButton Grid.Column="1"
                              Style="{StaticResource ToggleButtonRevealStyle}"
                              IsChecked="{x:Bind IsFavorite, Mode=OneWay}"
                              AutomationProperties.Name="{x:Bind FavoriteLabel}"
                              Width="40" Height="40"
                              MinWidth="40" MinHeight="40"
                              Padding="0"
                              CornerRadius="0"
                              VerticalAlignment="Center"
                              Margin="4,0,0,0"
                              Checked="HomeFavoriteToggle_Checked"
                              Unchecked="HomeFavoriteToggle_Unchecked">
                    <FontIcon Glyph="{x:Bind FavoriteGlyph, Mode=OneWay}"
                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                              FontSize="16"
                              IsTextScaleFactorEnabled="False"/>
                </ToggleButton>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="WelcomeDialogContentTemplate">
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="24"
                            Margin="0,8,0,8">
                    <FontIcon Glyph="&#xE734;" FontSize="32" AutomationProperties.AccessibilityView="Raw"/>
                    <FontIcon Glyph="&#xE9A1;" FontSize="32" AutomationProperties.AccessibilityView="Raw"/>
                    <FontIcon Glyph="&#xE774;" FontSize="32" AutomationProperties.AccessibilityView="Raw"/>
                </StackPanel>

                <TextBlock x:Uid="MainWelcomeToTheBeta"
                           Style="{StaticResource BodyTextBlockStyle}"
                           TextWrapping="Wrap"
                           Opacity="0.9"/>

                <CheckBox x:Uid="WelcomeDontShowCheckBox" x:Name="WelcomeDontShowCheckBox"
                          Margin="0,4,0,0"/>
            </StackPanel>
        </DataTemplate>

        <Storyboard x:Key="PanelEnterStoryboard">
            <DoubleAnimation Storyboard.TargetName="ContentPanel"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:0.3"
                             EasingFunction="{StaticResource PanelEnterEase}"/>
            <DoubleAnimation Storyboard.TargetName="ContentPanelTransform"
                             Storyboard.TargetProperty="Y"
                             From="24" To="0"
                             Duration="0:0:0.3"
                             EasingFunction="{StaticResource PanelEnterEase}"/>
        </Storyboard>
    </Page.Resources>

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid x:Name="AppTitleBar"
              Height="32"
              VerticalAlignment="Top"
              Canvas.ZIndex="1"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInset" Width="0"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="TitleBarRightInset" Width="0"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Uid="AppTitleText" x:Name="AppTitleText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumHighBrush}"/>
        </Grid>

        <NavigationView x:Name="NavView"
                         PaneDisplayMode="Auto"
                         CompactPaneLength="48"
                         OpenPaneLength="320"
                         IsBackButtonVisible="Collapsed"
                         IsSettingsVisible="True"
                         IsPaneToggleButtonVisible="True"
                         ItemInvoked="NavView_ItemInvoked"
                         Loaded="NavView_Loaded"
                         DisplayModeChanged="NavView_DisplayModeChanged"
                         PaneOpening="NavView_PaneOpening"
                         PaneClosing="NavView_PaneClosing"
                         Background="Transparent">

            <NavigationView.Resources>
                <x:Double x:Key="NavigationViewCompactPaneLength">48</x:Double>
                <x:Double x:Key="PaneToggleButtonWidth">48</x:Double>
                <Thickness x:Key="NavigationViewItemIconBoxMargin">16,12,16,12</Thickness>
            </NavigationView.Resources>

            <NavigationView.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               Style="{StaticResource TitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level1"
                               VerticalAlignment="Top"
                               TextTrimming="CharacterEllipsis"
                               Margin="12,0,12,0"/>
                </DataTemplate>
            </NavigationView.HeaderTemplate>

            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Uid="NavSearchBox" x:Name="NavSearchBox"
                                QueryIcon="Find"
                                AutomationProperties.LandmarkType="Search"
                                MaxSuggestionListHeight="400"
                                TextChanged="NavSearchBox_TextChanged"
                                QuerySubmitted="NavSearchBox_QuerySubmitted"
                                SuggestionChosen="NavSearchBox_SuggestionChosen">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="local:SearchItem">
                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,4">
                                <FontIcon Glyph="{x:Bind Icon}"
                                          FontSize="16"
                                          VerticalAlignment="Center"
                                          Opacity="0.8"
                                          AutomationProperties.AccessibilityView="Raw"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}"/>
                                    <TextBlock Text="{x:Bind Category}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </NavigationView.AutoSuggestBox>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="MainHome" Tag="LatestNews"
                                     AccessKey="H">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainGames" Tag="Games"
                                     AccessKey="G">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Play"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainBetaPrograms" Tag="Betas"
                                     AccessKey="B">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="PreviewLink"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="ProfileNavItem" x:Name="ProfileNavItem" Tag="Profile"
                                     AccessKey="P">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Contact"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainSocial" Tag="Social"
                                     AccessKey="S">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="People"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid x:Name="ContentHost" Background="Transparent"
                  AutomationProperties.LandmarkType="Main">
                <Frame x:Name="ContentFrame" Visibility="Collapsed"/>

                <!-- An indeterminate ProgressBar, not a ProgressRing. The sitemap loads in the
                     background and the user can navigate, search and click throughout; chunk_027
                     ("When to use each control") reserves the ring for modal waits - "the user is
                     blocked until the ProgressRing disappears" - and lists "Loading..." among the
                     keywords that call for a ProgressBar instead. Canvas.ZIndex keeps it over the
                     content it sits above regardless of declaration order. -->
                <ProgressBar x:Uid="SitemapLoadingBar" x:Name="LoadingIndicator"
                             IsIndeterminate="False"
                             Visibility="Collapsed"
                             VerticalAlignment="Top"
                             HorizontalAlignment="Stretch"
                             Canvas.ZIndex="1"/>

                <!-- IsTabStop because generic.xaml's ScrollViewer style sets it False, and this is
                     the element ShowContent moves focus to after a nav gesture. It also gives the
                     scrollable region a keyboard stop of its own, so arrow keys scroll it. -->
                <ScrollViewer x:Name="ContentScrollViewer" IsTabStop="True">
                    <StackPanel x:Name="ContentPanel" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="ContentPanelTransform"/>
                        </StackPanel.RenderTransform>
                        <StackPanel x:Name="LatestNewsPanel" Visibility="Visible">
                            <TextBlock x:Uid="MainCheckBackHereFor"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                       Margin="0,0,0,24"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0"
                                      Background="{ThemeResource CardBackgroundBrush}"
                                      BorderBrush="{ThemeResource CardBorderBrush}"
                                      BorderThickness="1"
                                      CornerRadius="4"
                                      Padding="20"
                                      MinHeight="180">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    Opacity="0.6" Margin="0,0,0,8">
                                            <FontIcon Glyph="&#xE789;" FontSize="12" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                                            <TextBlock x:Uid="MainWelcome"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Uid="MainWelcomeToVersion2"
                                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                                   AutomationProperties.HeadingLevel="Level2"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,12"/>
                                        <TextBlock x:Uid="MainThisUpdateFixesMany"
                                                   Style="{StaticResource BodyTextBlockStyle}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumHighBrush}"
                                                   Margin="0,0,0,12"/>
                                        <TextBlock x:Uid="MainJustNow"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Column="2"
                                      Background="{ThemeResource CardBackgroundBrush}"
                                      BorderBrush="{ThemeResource CardBorderBrush}"
                                      BorderThickness="1"
                                      CornerRadius="4"
                                      Padding="20"
                                      MinHeight="180">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    Opacity="0.6" Margin="0,0,0,8">
                                            <FontIcon Glyph="&#xE7FC;" FontSize="12" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                                            <TextBlock x:Uid="MainSoon3"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Uid="MainSoonSoonSoon"
                                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                                   AutomationProperties.HeadingLevel="Level2"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,12"/>
                                        <TextBlock x:Uid="MainSoonYouWillBe"
                                                   Style="{StaticResource BodyTextBlockStyle}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumHighBrush}"
                                                   Margin="0,0,0,12"/>
                                        <TextBlock x:Uid="MainInTheFutureMaybe"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- Favorites, beneath the news cards. Lives inside LatestNewsPanel so
                                 it is shown and hidden by the existing ShowContent default case
                                 with no navigation changes at all.

                                 An ItemsControl rather than a ListView: nothing here is selectable,
                                 and a virtualizing list inside the page's own ScrollViewer would
                                 reintroduce the nested-scrolling problem the games SemanticZoom
                                 already has to work around. The cap makes virtualization pointless
                                 anyway. -->
                            <StackPanel x:Name="FavoritesSection" Margin="0,32,0,0">
                                <TextBlock x:Uid="HomeFavoritesHeader"
                                           Style="{StaticResource SubtitleTextBlockStyle}"
                                           AutomationProperties.HeadingLevel="Level2"
                                           Margin="0,0,0,12"/>

                                <TextBlock x:Uid="HomeFavoritesEmpty"
                                           x:Name="FavoritesEmptyText"
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed"/>

                                <ItemsControl x:Name="FavoritesList"
                                              ItemTemplate="{StaticResource HomeFavoriteItemTemplate}"
                                              MaxWidth="700"
                                              HorizontalAlignment="Stretch"/>

                                <HyperlinkButton x:Uid="HomeFavoritesSeeAll"
                                                 x:Name="FavoritesSeeAllLink"
                                                 Margin="0,8,0,0"
                                                 Visibility="Collapsed"
                                                 Click="FavoritesSeeAll_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="BetasPanel" Visibility="Collapsed">
                            <TextBlock x:Uid="MainAccessBetaVersionsAnd"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel x:Name="SocialPanel" Visibility="Collapsed">
                            <TextBlock x:Uid="MainSocialFeaturesComingSoon"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
                            <TextBlock x:Uid="MainMakeFortDesktopWork"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                       Margin="0,0,0,24"/>

                            <StackPanel MaxWidth="700" HorizontalAlignment="Stretch" Spacing="0">
                                <StackPanel.ChildrenTransitions>
                                    <TransitionCollection>
                                        <EntranceThemeTransition FromVerticalOffset="40"/>
                                        <RepositionThemeTransition/>
                                    </TransitionCollection>
                                </StackPanel.ChildrenTransitions>

                                <Border BorderThickness="0,0,0,1"
                                        BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}">
                                    <StackPanel>
                                        <local:ExpanderHeaderButton x:Uid="MainAppearance" x:Name="AppearanceHeader"
                                                Style="{StaticResource ButtonRevealStyle}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                MinWidth="0"
                                                CornerRadius="0"
                                                Padding="16,12"
                                                AutomationProperties.HeadingLevel="Level2"
                                                Click="AppearanceHeader_Tapped">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="36" Height="36" CornerRadius="2"
                                                      Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                                                    <FontIcon Glyph="&#xE771;" FontSize="16"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              AutomationProperties.AccessibilityView="Raw"/>
                                                </Grid>
                                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock x:Uid="MainAppearance2" Style="{StaticResource BaseTextBlockStyle}"/>
                                                    <TextBlock x:Uid="MainChangeAppThemeAnd"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                                </StackPanel>
                                                <FontIcon x:Name="AppearanceChevron" Grid.Column="2" Glyph="&#xE76C;"
                                                          FontSize="12" VerticalAlignment="Center"
                                                          AutomationProperties.AccessibilityView="Raw"
                                                          Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                          RenderTransformOrigin="0.5,0.5">
                                                    <FontIcon.RenderTransform>
                                                        <RotateTransform x:Name="AppearanceChevronRotation" Angle="0"/>
                                                    </FontIcon.RenderTransform>
                                                </FontIcon>
                                            </Grid>
                                        </local:ExpanderHeaderButton>
                                        <StackPanel x:Name="AppearanceContent" Visibility="Collapsed"
                                                    Padding="20,0,20,16">
                                            <StackPanel.ChildrenTransitions>
                                                <TransitionCollection>
                                                    <EntranceThemeTransition FromVerticalOffset="20"/>
                                                </TransitionCollection>
                                            </StackPanel.ChildrenTransitions>
                                            <Rectangle Height="1" Margin="0,0,0,14"
                                                       Fill="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                                       Opacity="0.08"/>
                                            <StackPanel Spacing="16">
                                                <StackPanel Spacing="8">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE793;" FontSize="14" Opacity="0.7" AutomationProperties.AccessibilityView="Raw"/>
                                                        <TextBlock x:Uid="MainAppTheme" Style="{StaticResource BodyTextBlockStyle}" FontWeight="SemiBold"
                                                                   AutomationProperties.HeadingLevel="Level3"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                                        <RadioButton x:Uid="ThemeSystemRadio" x:Name="ThemeSystemRadio"
                                                                     GroupName="AppTheme" Tag="Default"
                                                                     Checked="ThemeRadio_Checked"/>
                                                        <RadioButton x:Uid="ThemeLightRadio" x:Name="ThemeLightRadio"
                                                                     GroupName="AppTheme" Tag="Light"
                                                                     Checked="ThemeRadio_Checked"/>
                                                        <RadioButton x:Uid="ThemeDarkRadio" x:Name="ThemeDarkRadio"
                                                                     GroupName="AppTheme" Tag="Dark"
                                                                     Checked="ThemeRadio_Checked"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Spacing="8">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE771;" FontSize="14" Opacity="0.7" AutomationProperties.AccessibilityView="Raw"/>
                                                        <TextBlock x:Uid="MainBackgroundTint" Style="{StaticResource BodyTextBlockStyle}" FontWeight="SemiBold"
                                                                   AutomationProperties.HeadingLevel="Level3"/>
                                                    </StackPanel>
                                                    <StackPanel Spacing="8">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Button x:Uid="TintDefaultButton" x:Name="TintDefaultButton" Tag="Default"
                                                                    Click="TintColorButton_Click"
                                                                    Width="40" Height="40" Padding="0" MinWidth="40"
                                                                    HorizontalContentAlignment="Stretch"
                                                                    VerticalContentAlignment="Stretch"
                                                                    BorderThickness="2" BorderBrush="Transparent">
                                                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                                    <FontIcon Glyph="&#xE8D8;" FontSize="14" AutomationProperties.AccessibilityView="Raw"
                                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    <FontIcon x:Name="TintDefaultCheck" Glyph="&#xE73E;" FontSize="12"
                                                                              HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                              Margin="0,0,2,1" Visibility="Collapsed"
                                                                              AutomationProperties.AccessibilityView="Raw"/>
                                                                </Grid>
                                                            </Button>
                                                            <Button x:Uid="TintBlueButton" x:Name="TintBlueButton" Tag="#1E3A5F"
                                                                    Click="TintColorButton_Click"
                                                                    Width="40" Height="40" Padding="0" MinWidth="40"
                                                                    Background="#1D6FA5" BorderThickness="2"
                                                                    BorderBrush="Transparent">
                                                                <FontIcon x:Name="TintBlueCheck" Glyph="&#xE73E;" FontSize="12"
                                                                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                          Margin="0,0,2,1" Visibility="Collapsed"
                                                                          AutomationProperties.AccessibilityView="Raw"/>
                                                            </Button>
                                                            <Button x:Uid="TintPurpleButton" x:Name="TintPurpleButton" Tag="#2D1B69"
                                                                    Click="TintColorButton_Click"
                                                                    Width="40" Height="40" Padding="0" MinWidth="40"
                                                                    Background="#6041B0" BorderThickness="2"
                                                                    BorderBrush="Transparent">
                                                                <FontIcon x:Name="TintPurpleCheck" Glyph="&#xE73E;" FontSize="12"
                                                                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                          Margin="0,0,2,1" Visibility="Collapsed"
                                                                          AutomationProperties.AccessibilityView="Raw"/>
                                                            </Button>
                                                            <Button x:Uid="TintGreenButton" x:Name="TintGreenButton" Tag="#0F3D2E"
                                                                    Click="TintColorButton_Click"
                                                                    Width="40" Height="40" Padding="0" MinWidth="40"
                                                                    Background="#1B7A4E" BorderThickness="2"
                                                                    BorderBrush="Transparent">
                                                                <FontIcon x:Name="TintGreenCheck" Glyph="&#xE73E;" FontSize="12"
                                                                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                          Margin="0,0,2,1" Visibility="Collapsed"
                                                                          AutomationProperties.AccessibilityView="Raw"/>
                                                            </Button>
                                                            <Button x:Uid="TintRedButton" x:Name="TintRedButton" Tag="#3D1515"
                                                                    Click="TintColorButton_Click"
                                                                    Width="40" Height="40" Padding="0" MinWidth="40"
                                                                    Background="#B03232" BorderThickness="2"
                                                                    BorderBrush="Transparent">
                                                                <FontIcon x:Name="TintRedCheck" Glyph="&#xE73E;" FontSize="12"
                                                                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                          Margin="0,0,2,1" Visibility="Collapsed"
                                                                          AutomationProperties.AccessibilityView="Raw"/>
                                                            </Button>
                                                            <Button x:Uid="TintSlateButton" x:Name="TintSlateButton" Tag="#1A1A2E"
                                                                    Click="TintColorButton_Click"
                                                                    Width="40" Height="40" Padding="0" MinWidth="40"
                                                                    Background="#404080" BorderThickness="2"
                                                                    BorderBrush="Transparent">
                                                                <FontIcon x:Name="TintSlateCheck" Glyph="&#xE73E;" FontSize="12"
                                                                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                          Margin="0,0,2,1" Visibility="Collapsed"
                                                                          AutomationProperties.AccessibilityView="Raw"/>
                                                            </Button>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Button x:Uid="TintTealButton" x:Name="TintTealButton" Tag="#0E3A3A"
                                                                    Click="TintColorButton_Click"
                                                                    Width="40" Height="40" Padding="0" MinWidth="40"
                                                                    Background="#1B8A8A" BorderThickness="2"
                                                                    BorderBrush="Transparent">
                                                                <FontIcon x:Name="TintTealCheck" Glyph="&#xE73E;" FontSize="12"
                                                                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                          Margin="0,0,2,1" Visibility="Collapsed"
                                                                          AutomationProperties.AccessibilityView="Raw"/>
                                                            </Button>
                                                            <Button x:Uid="TintBronzeButton" x:Name="TintBronzeButton" Tag="#3D2A0F"
                                                                    Click="TintColorButton_Click"
                                                                    Width="40" Height="40" Padding="0" MinWidth="40"
                                                                    Background="#B07D1B" BorderThickness="2"
                                                                    BorderBrush="Transparent">
                                                                <FontIcon x:Name="TintBronzeCheck" Glyph="&#xE73E;" FontSize="12"
                                                                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                          Margin="0,0,2,1" Visibility="Collapsed"
                                                                          AutomationProperties.AccessibilityView="Raw"/>
                                                            </Button>
                                                            <Button x:Uid="TintRoseButton" x:Name="TintRoseButton" Tag="#3D1533"
                                                                    Click="TintColorButton_Click"
                                                                    Width="40" Height="40" Padding="0" MinWidth="40"
                                                                    Background="#B03291" BorderThickness="2"
                                                                    BorderBrush="Transparent">
                                                                <FontIcon x:Name="TintRoseCheck" Glyph="&#xE73E;" FontSize="12"
                                                                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                          Margin="0,0,2,1" Visibility="Collapsed"
                                                                          AutomationProperties.AccessibilityView="Raw"/>
                                                            </Button>
                                                            <Button x:Uid="TintOliveButton" x:Name="TintOliveButton" Tag="#2E3D0F"
                                                                    Click="TintColorButton_Click"
                                                                    Width="40" Height="40" Padding="0" MinWidth="40"
                                                                    Background="#6E8A1B" BorderThickness="2"
                                                                    BorderBrush="Transparent">
                                                                <FontIcon x:Name="TintOliveCheck" Glyph="&#xE73E;" FontSize="12"
                                                                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                          Margin="0,0,2,1" Visibility="Collapsed"
                                                                          AutomationProperties.AccessibilityView="Raw"/>
                                                            </Button>
                                                            <Button x:Uid="TintGraphiteButton" x:Name="TintGraphiteButton" Tag="#232323"
                                                                    Click="TintColorButton_Click"
                                                                    Width="40" Height="40" Padding="0" MinWidth="40"
