<Page
    x:Class="Fort.ind_UWP.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fort.ind_UWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    KeyboardAcceleratorPlacementMode="Hidden"
    Background="Transparent">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="FocusSearchAccelerator_Invoked"/>
        <KeyboardAccelerator Key="Escape" Invoked="ClearSearchAccelerator_Invoked"/>
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <DataTemplate x:Key="WelcomeDialogContentTemplate">
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="24"
                            Margin="0,8,0,8">
                    <FontIcon Glyph="&#xE734;" FontSize="32" AutomationProperties.AccessibilityView="Raw"/>
                    <FontIcon Glyph="&#xE9A1;" FontSize="32" AutomationProperties.AccessibilityView="Raw"/>
                    <FontIcon Glyph="&#xE774;" FontSize="32" AutomationProperties.AccessibilityView="Raw"/>
                </StackPanel>

                <TextBlock x:Uid="MainWelcomeToTheBeta"
                           Style="{StaticResource BodyTextBlockStyle}"
                           TextWrapping="Wrap"
                           Opacity="0.9"/>

                <CheckBox x:Uid="WelcomeDontShowCheckBox" x:Name="WelcomeDontShowCheckBox"
                          Margin="0,4,0,0"/>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid x:Name="AppTitleBar"
              Height="32"
              VerticalAlignment="Top"
              Canvas.ZIndex="1"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInset" Width="0"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="TitleBarRightInset" Width="0"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Uid="AppTitleText" x:Name="AppTitleText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumHighBrush}"/>
        </Grid>

        <NavigationView x:Name="NavView"
                         PaneDisplayMode="Auto"
                         CompactPaneLength="48"
                         OpenPaneLength="320"
                         IsBackButtonVisible="Collapsed"
                         IsSettingsVisible="True"
                         IsPaneToggleButtonVisible="True"
                         ItemInvoked="NavView_ItemInvoked"
                         Loaded="NavView_Loaded"
                         DisplayModeChanged="NavView_DisplayModeChanged"
                         PaneOpening="NavView_PaneOpening"
                         PaneClosing="NavView_PaneClosing"
                         Background="Transparent">

            <NavigationView.Resources>
                <x:Double x:Key="NavigationViewCompactPaneLength">48</x:Double>
                <x:Double x:Key="PaneToggleButtonWidth">48</x:Double>
                <Thickness x:Key="NavigationViewItemIconBoxMargin">16,12,16,12</Thickness>
            </NavigationView.Resources>

            <NavigationView.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               Style="{StaticResource TitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level1"
                               VerticalAlignment="Top"
                               TextTrimming="CharacterEllipsis"
                               Margin="12,0,12,0"/>
                </DataTemplate>
            </NavigationView.HeaderTemplate>

            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Uid="NavSearchBox" x:Name="NavSearchBox"
                                QueryIcon="Find"
                                AutomationProperties.LandmarkType="Search"
                                MaxSuggestionListHeight="400"
                                TextChanged="NavSearchBox_TextChanged"
                                QuerySubmitted="NavSearchBox_QuerySubmitted"
                                SuggestionChosen="NavSearchBox_SuggestionChosen">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="local:SearchItem">
                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,4">
                                <FontIcon Glyph="{x:Bind Icon}"
                                          FontSize="16"
                                          VerticalAlignment="Center"
                                          Opacity="0.8"
                                          AutomationProperties.AccessibilityView="Raw"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}"/>
                                    <TextBlock Text="{x:Bind Category}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </NavigationView.AutoSuggestBox>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="MainHome" Tag="LatestNews"
                                     AccessKey="H">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainGames" Tag="Games"
                                     AccessKey="G">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Play"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainBetaPrograms" Tag="Betas"
                                     AccessKey="B">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="PreviewLink"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="ProfileNavItem" x:Name="ProfileNavItem" Tag="Profile"
                                     AccessKey="P">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Contact"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainSocial" Tag="Social"
                                     AccessKey="S">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="People"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid x:Name="ContentHost" Background="Transparent"
                  AutomationProperties.LandmarkType="Main">
                <Frame x:Name="ContentFrame"/>

                <ProgressBar x:Uid="SitemapLoadingBar" x:Name="LoadingIndicator"
                             IsIndeterminate="False"
                             Visibility="Collapsed"
                             VerticalAlignment="Top"
                             HorizontalAlignment="Stretch"
                             Canvas.ZIndex="1"/>
            </Grid>

        </NavigationView>

    </Grid>
</Page>
