<Page
    x:Class="Fort.ind_UWP.SocialChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fort.ind_UWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled"
    KeyboardAcceleratorPlacementMode="Hidden"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="SocialChatConversationTemplate" x:DataType="local:SocialChatConversation">
            <Grid AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
                <Rectangle Width="3"
                           HorizontalAlignment="Left"
                           Fill="{ThemeResource SystemControlHighlightAccentBrush}"
                           Visibility="{x:Bind UnreadVisibility, Mode=OneWay}"
                           AutomationProperties.AccessibilityView="Raw"/>

                <Grid Margin="12,10,12,10" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <PersonPicture Width="40" Height="40"
                                   VerticalAlignment="Center"
                                   DisplayName="{x:Bind PlainName, Mode=OneWay}"
                                   ProfilePicture="{x:Bind Avatar, Mode=OneWay}"
                                   AutomationProperties.AccessibilityView="Raw"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind PlainName, Mode=OneWay}"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   FontWeight="{x:Bind NameWeight, Mode=OneWay}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock Text="{x:Bind Preview, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1"
                                   AutomationProperties.AccessibilityView="Raw"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind TimeText, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                                   HorizontalAlignment="Right"
                                   AutomationProperties.AccessibilityView="Raw"/>
                        <Ellipse Width="8" Height="8"
                                 Margin="0,6,0,0"
                                 HorizontalAlignment="Right"
                                 Fill="{ThemeResource SystemControlHighlightAccentBrush}"
                                 Visibility="{x:Bind UnreadVisibility, Mode=OneWay}"
                                 AutomationProperties.AccessibilityView="Raw"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SocialChatPersonSuggestionTemplate" x:DataType="local:SocialUser">
            <StackPanel Padding="0,4,0,4">
                <TextBlock Text="{x:Bind DisplayName}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{x:Bind Handle}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="SocialChatRowContainerStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="BannerPanel.Margin" Value="12,8,12,0"/>
                        <Setter Target="ContentGrid.Margin" Value="0,0,0,0"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="641"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="BannerPanel.Margin" Value="24,12,24,0"/>
                        <Setter Target="ContentGrid.Margin" Value="12,12,12,0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="PaneStates" CurrentStateChanged="PaneStates_CurrentStateChanged">
                <VisualState x:Name="OnePaneState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ListColumn.Width" Value="*"/>
                        <Setter Target="ConversationColumn.Width" Value="0"/>
                        <Setter Target="PaneDivider.Visibility" Value="Collapsed"/>
                        <Setter Target="ConversationHost.Visibility" Value="Collapsed"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="TwoPaneState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="760"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ListColumn.Width" Value="320"/>
                        <Setter Target="ConversationColumn.Width" Value="*"/>
                        <Setter Target="PaneDivider.Visibility" Value="Visible"/>
                        <Setter Target="ConversationHost.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel x:Name="BannerPanel">
            <muxc:InfoBar x:Uid="SocialChatSignedOutInfoBar" x:Name="SignedOutInfoBar"
                          Margin="0,0,0,8"
                          Severity="Informational"
                          IsOpen="False"
                          IsClosable="False"
                          Visibility="Collapsed">
                <muxc:InfoBar.ActionButton>
                    <Button x:Uid="SocialChatSignInButton" Click="SignInButton_Click"/>
                </muxc:InfoBar.ActionButton>
            </muxc:InfoBar>

            <muxc:InfoBar x:Uid="SocialChatSignInAgainInfoBar" x:Name="SignInAgainInfoBar"
                          Margin="0,0,0,8"
                          Severity="Warning"
                          IsOpen="False"
                          IsClosable="False"
                          Visibility="Collapsed">
                <muxc:InfoBar.ActionButton>
                    <Button x:Uid="SocialChatSignInAgainButton" Click="SignInButton_Click"/>
                </muxc:InfoBar.ActionButton>
            </muxc:InfoBar>

            <muxc:InfoBar x:Uid="SocialChatUnavailableInfoBar" x:Name="UnavailableInfoBar"
                          Margin="0,0,0,8"
                          Severity="Informational"
                          IsOpen="False"
                          IsClosable="False"
                          Visibility="Collapsed"/>
        </StackPanel>

        <Grid x:Name="ContentGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="320"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="ConversationColumn" Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="ListPane">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Padding="12,4,8,8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Uid="SocialChatNewChatButton" x:Name="NewChatButton"
                            Style="{StaticResource AccentButtonStyle}"
                            VerticalAlignment="Center">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="N" Modifiers="Control"/>
                        </Button.KeyboardAccelerators>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="16" IsTextScaleFactorEnabled="False"/>
                            <TextBlock x:Uid="SocialChatNewChatLabel"/>
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout x:Name="NewChatFlyout" Placement="Bottom" Opened="NewChatFlyout_Opened">
                                <StackPanel Width="300" Spacing="8">
                                    <TextBlock x:Uid="SocialChatNewChatHeader" Style="{StaticResource BaseTextBlockStyle}"/>
                                    <AutoSuggestBox x:Uid="SocialChatPersonSearch" x:Name="PersonSearch"
                                                    QueryIcon="Find"
                                                    ItemTemplate="{StaticResource SocialChatPersonSuggestionTemplate}"
                                                    TextChanged="PersonSearch_TextChanged"
                                                    QuerySubmitted="PersonSearch_QuerySubmitted"/>
                                    <TextBlock x:Name="PersonSearchStatus"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="Collapsed"
                                               AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <ListView x:Uid="SocialChatConversationList" x:Name="ConversationList"
                          Grid.Row="1"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemTemplate="{StaticResource SocialChatConversationTemplate}"
                          ItemContainerStyle="{StaticResource SocialChatRowContainerStyle}"
                          ItemClick="ConversationList_ItemClick"
                          ContextRequested="ConversationList_ContextRequested"/>

                <local:SocialLoadingIndicator x:Uid="SocialChatListLoading" x:Name="ListLoading"
                                              Grid.Row="1"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsActive="False"
                                              Visibility="Collapsed"/>

                <StackPanel x:Name="ListStatePanel"
                            Grid.Row="1"
                            Margin="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="280"
                            Visibility="Collapsed">
                    <TextBlock x:Name="ListStateText"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               AutomationProperties.LiveSetting="Polite"/>
                    <Button x:Uid="SocialChatRetryLoadButton" x:Name="ListRetryButton"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed"
                            Click="ListRetryButton_Click"/>
                </StackPanel>
            </Grid>

            <Rectangle x:Name="PaneDivider"
                       Grid.Column="1"
                       Width="1"
                       Fill="{ThemeResource SystemControlForegroundBaseLowBrush}"
                       AutomationProperties.AccessibilityView="Raw"/>

            <Grid x:Name="ConversationHost" Grid.Column="2">
                <local:SocialChatView x:Name="ChatView"/>

                <TextBlock x:Uid="SocialChatPickConversation" x:Name="PickConversationText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="24"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
