<Page
    x:Class="Fort.ind_UWP.GamesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fort.ind_UWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:data="using:Windows.UI.Xaml.Data"
    mc:Ignorable="d"
    KeyboardAcceleratorPlacementMode="Hidden"
    Background="Transparent">

    <Page.Resources>
        <CollectionViewSource x:Key="GamesViewSource"
                              IsSourceGrouped="True"
                              ItemsPath="Items"/>

        <DataTemplate x:Key="GameItemTemplate" x:DataType="local:SearchItem">
            <Grid MinHeight="64"
                  AutomationProperties.Name="{x:Bind Title}"
                  AutomationProperties.HelpText="{x:Bind Category}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.RowSpan="2"
                           Text="{x:Bind Icon}"
                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                           FontSize="20"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                           IsTextScaleFactorEnabled="False"
                           AutomationProperties.AccessibilityView="Raw"/>

                <TextBlock Grid.Column="1" Grid.Row="0"
                           Text="{x:Bind Title}"
                           Style="{StaticResource BaseTextBlockStyle}"
                           Foreground="{ThemeResource SystemControlPageTextBaseHighBrush}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Bottom"
                           AutomationProperties.AccessibilityView="Raw"/>

                <TextBlock Grid.Column="1" Grid.Row="1"
                           Text="{x:Bind Category}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Top"
                           AutomationProperties.AccessibilityView="Raw"/>

                <!-- A ToggleButton rather than a Button so UIA reports the on/off state for free
                     through IToggleProvider - the accessibility docs require a control to announce
                     name, state and type, and a Button would need a custom peer to do it (see
                     Controls/ExpanderHeaderButton.cs for that pattern).

                     Mode=OneWay is load-bearing: x:Bind is OneTime by default, which would freeze
                     each star at whatever the first item realised into that recycled container had.

                     The glyph swap is the point of FavoriteGlyph - ToggleButtonRevealStyle's
                     Checked state carries state by accent fill alone, and colour must never be the
                     only carrier. This FontIcon is deliberately not AccessibilityView="Raw": unlike
                     every other glyph in the app it is the control's only content, not decoration
                     sitting beside a label that already names the thing. -->
                <ToggleButton Grid.Column="2" Grid.RowSpan="2"
                              Style="{StaticResource ToggleButtonRevealStyle}"
                              IsChecked="{x:Bind IsFavorite, Mode=OneWay}"
                              AutomationProperties.Name="{x:Bind FavoriteLabel}"
                              Width="40" Height="40"
                              MinWidth="40" MinHeight="40"
                              Padding="0"
                              CornerRadius="0"
                              VerticalAlignment="Center"
                              Margin="12,0,0,0"
                              Checked="FavoriteToggle_Checked"
                              Unchecked="FavoriteToggle_Unchecked">
                    <FontIcon Glyph="{x:Bind FavoriteGlyph, Mode=OneWay}"
                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                              FontSize="16"
                              IsTextScaleFactorEnabled="False"/>
                </ToggleButton>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GameGroupHeaderTemplate" x:DataType="local:GameGroup">
            <TextBlock Text="{x:Bind Key}"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       TextWrapping="NoWrap"
                       AutomationProperties.Name="{x:Bind Key}"/>
        </DataTemplate>

        <DataTemplate x:Key="GameJumpItemTemplate" x:DataType="data:ICollectionViewGroup">
            <TextBlock Text="{x:Bind ((local:GameGroup)Group).Key}"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Foreground="{ThemeResource SystemControlPageTextBaseHighBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       AutomationProperties.Name="{x:Bind ((local:GameGroup)Group).Key}"/>
        </DataTemplate>

        <Style x:Key="GameItemContainerStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,0,12,0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="GameJumpItemContainerStyle" TargetType="GridViewItem">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="72"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{ThemeResource SystemControlBackgroundListLowBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>

    </Page.Resources>

    <Grid x:Name="RootGrid" Padding="24">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootGrid.Padding" Value="12"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="641"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootGrid.Padding" Value="24"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="480"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Uid="FilterBox" x:Name="FilterBox"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            QueryIcon="Find"
                            IsEnabled="False"
                            TextChanged="FilterBox_TextChanged"/>
        </Grid>

        <TextBlock x:Name="CountText"
                   Grid.Row="1"
                   Text=""
                   Margin="0,0,0,8"
                   Style="{StaticResource BodyTextBlockStyle}"
                   Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                   TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis"
                   AutomationProperties.LiveSetting="Polite"/>

        <Grid Grid.Row="2">
            <SemanticZoom x:Uid="GamesZoom" x:Name="GamesZoom"
                          Visibility="Collapsed">

                <SemanticZoom.ZoomedInView>
                    <ListView x:Uid="GamesList" x:Name="GamesList"
                              ItemTemplate="{StaticResource GameItemTemplate}"
                              ItemContainerStyle="{StaticResource GameItemContainerStyle}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="GamesList_ItemClick"
                              Padding="0,0,16,0"
                              ScrollViewer.IsVerticalScrollChainingEnabled="False">
                        <ListView.GroupStyle>
                            <GroupStyle HeaderTemplate="{StaticResource GameGroupHeaderTemplate}"
                                        HidesIfEmpty="True"/>
                        </ListView.GroupStyle>
                    </ListView>
                </SemanticZoom.ZoomedInView>

                <SemanticZoom.ZoomedOutView>
                    <GridView x:Uid="GamesJumpGrid" x:Name="GamesJumpGrid"
                              ItemTemplate="{StaticResource GameJumpItemTemplate}"
                              ItemContainerStyle="{StaticResource GameJumpItemContainerStyle}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              Padding="0,0,16,0"
                              ScrollViewer.IsHorizontalScrollChainingEnabled="False"/>
                </SemanticZoom.ZoomedOutView>

            </SemanticZoom>

            <StackPanel x:Name="LoadingPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <ProgressRing x:Name="LoadingRing"
                              IsActive="True"
                              Width="32" Height="32"
                              HorizontalAlignment="Center"/>
                <TextBlock x:Uid="GamesLoadingGames"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                           HorizontalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>

            <StackPanel x:Name="EmptyPanel"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="360"
                        Spacing="12">
                <TextBlock x:Uid="GamesXe721"
                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                           FontSize="32"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                           AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock x:Uid="EmptyText" x:Name="EmptyText"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>

            <StackPanel x:Name="ErrorPanel"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="360"
                        Spacing="12">
                <TextBlock x:Uid="GamesXe783"
                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                           FontSize="32"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                           AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock x:Uid="GamesTheGamesListCould"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
                <Button x:Uid="RetryButton" x:Name="RetryButton"
                        HorizontalAlignment="Center"
                        Click="RetryButton_Click"/>
            </StackPanel>

        </Grid>
    </Grid>
</Page>
