<Page
    x:Class="Fort.ind_UWP.SocialPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fort.ind_UWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    KeyboardAcceleratorPlacementMode="Hidden"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="SocialNoteItemTemplate" x:DataType="local:SocialNoteItem">
            <local:SocialNoteView Item="{x:Bind}"
                                  AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"/>
        </DataTemplate>

        <DataTemplate x:Key="SocialFeedItemTemplate" x:DataType="local:SocialFeedItem">
            <Grid AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
                <Rectangle Width="3"
                           HorizontalAlignment="Left"
                           Fill="{ThemeResource SystemControlHighlightAccentBrush}"
                           Visibility="{x:Bind UnreadVisibility, Mode=OneWay}"
                           AutomationProperties.AccessibilityView="Raw"/>

                <Grid Margin="12,10,12,10" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Style="{StaticResource SocialBareButtonStyle}"
                            Visibility="{x:Bind ActorVisibility}"
                            IsHitTestVisible="{x:Bind HasActorProfile}"
                            IsTabStop="{x:Bind HasActorProfile}"
                            AutomationProperties.Name="{x:Bind ActorProfileLabel}"
                            ToolTipService.ToolTip="{x:Bind ActorProfileLabel}"
                            Click="FeedActorButton_Click">
                        <PersonPicture Width="40" Height="40"
                                       DisplayName="{x:Bind ActorName}"
                                       ProfilePicture="{x:Bind Avatar}"
                                       BadgeGlyph="{x:Bind Glyph}"
                                       AutomationProperties.AccessibilityView="Raw"/>
                    </Button>

                    <Grid Width="40" Height="40"
                          VerticalAlignment="Top"
                          Visibility="{x:Bind GlyphPlateVisibility}"
                          AutomationProperties.AccessibilityView="Raw">
                        <Ellipse Fill="{ThemeResource SystemControlBackgroundBaseLowBrush}"/>
                        <FontIcon Glyph="{x:Bind Glyph}"
                                  FontSize="16"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  IsTextScaleFactorEnabled="False"/>
                    </Grid>

                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{x:Bind Title}"
                                   Style="{StaticResource BaseTextBlockStyle}"
                                   Foreground="{ThemeResource SystemControlPageTextBaseHighBrush}"
                                   TextWrapping="Wrap"
                                   MaxLines="2"
                                   TextTrimming="CharacterEllipsis"
                                   AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock Text="{x:Bind Body}"
                                   Visibility="{x:Bind BodyVisibility}"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                                   TextWrapping="Wrap"
                                   MaxLines="3"
                                   TextTrimming="CharacterEllipsis"
                                   AutomationProperties.AccessibilityView="Raw"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="{x:Bind TimeText, Mode=OneWay}"
                               ToolTipService.ToolTip="{x:Bind TimeFull}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                               TextWrapping="NoWrap"
                               AutomationProperties.AccessibilityView="Raw"/>
                </Grid>
            </Grid>
        </DataTemplate>

        <Style x:Key="SocialFeedItemContainerStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="SocialStatePanelStyle" TargetType="StackPanel">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MaxWidth" Value="360"/>
            <Setter Property="Spacing" Value="12"/>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SocialPivot.Margin" Value="0,0,0,0"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="641"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SocialPivot.Margin" Value="12,12,12,0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Pivot x:Uid="SocialPivot" x:Name="SocialPivot"
               Visibility="Collapsed"
               SelectionChanged="SocialPivot_SelectionChanged">
            <Pivot.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{StaticResource SubtitleTextBlockStyle}"/>
                </DataTemplate>
            </Pivot.HeaderTemplate>

            <Pivot.RightHeader>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Uid="SocialNewNoteButton" x:Name="NewNoteButton"
                        Style="{StaticResource AccentButtonStyle}"
                        VerticalAlignment="Center"
                        Click="NewNoteButton_Click">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control"/>
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE70F;" FontSize="16" IsTextScaleFactorEnabled="False"/>
                        <TextBlock x:Uid="SocialNewNoteLabel"/>
                    </StackPanel>
                </Button>
                <Button x:Uid="SocialRefreshButton" x:Name="SocialRefreshButton"
                        Style="{StaticResource ButtonRevealStyle}"
                        Background="Transparent"
                        Width="40" Height="40"
                        MinWidth="40" MinHeight="40"
                        Padding="0"
                        CornerRadius="0"
                        VerticalAlignment="Center"
                        Click="SocialRefreshButton_Click">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5"/>
                    </Button.KeyboardAccelerators>
                    <FontIcon Glyph="&#xE72C;" FontSize="16" IsTextScaleFactorEnabled="False"/>
                </Button>
                </StackPanel>
            </Pivot.RightHeader>

            <PivotItem x:Uid="SocialForYouPivotItem" x:Name="ForYouPivotItem">
                <Grid>
                    <ListView x:Uid="SocialForYouList" x:Name="ForYouList"
                              ItemTemplate="{StaticResource SocialNoteItemTemplate}"
                              ItemContainerStyle="{StaticResource SocialFeedItemContainerStyle}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="NoteList_ItemClick"
                              Visibility="Collapsed">
                        <i:Interaction.Behaviors>
                            <local:SocialContextMenuBehavior/>
                            <local:SocialNoteShortcutsBehavior/>
                            <local:SocialFeedListBehavior BackToNewest="{x:Bind ForYouBackToNewestButton}"/>
                        </i:Interaction.Behaviors>

                        <ListView.Header>
                            <Button x:Name="ForYouBackToNewestButton"
                                    Margin="12,8,12,8"
                                    HorizontalAlignment="Stretch"
                                    Visibility="Collapsed"
                                    Click="BackToNewestButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74A;" FontSize="16" IsTextScaleFactorEnabled="False"/>
                                    <TextBlock x:Uid="SocialBackToNewest"/>
                                </StackPanel>
                            </Button>
                        </ListView.Header>
                    </ListView>

                    <ProgressRing x:Uid="SocialForYouLoading" x:Name="ForYouLoadingRing"
                                  Width="32" Height="32"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <StackPanel x:Name="ForYouStatePanel"
                                Style="{StaticResource SocialStatePanelStyle}"
                                Visibility="Collapsed">
                        <FontIcon x:Name="ForYouStateGlyph"
                                  FontSize="32"
                                  HorizontalAlignment="Center"
                                  Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                                  AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock x:Name="ForYouStateText"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <Button x:Name="ForYouStateButton"
                                HorizontalAlignment="Center"
                                Click="TimelineStateButton_Click"/>
                    </StackPanel>
                </Grid>
            </PivotItem>

            <PivotItem x:Uid="SocialFollowingPivotItem" x:Name="FollowingPivotItem">
                <Grid>
                    <ListView x:Uid="SocialFollowingList" x:Name="FollowingList"
                              ItemTemplate="{StaticResource SocialNoteItemTemplate}"
                              ItemContainerStyle="{StaticResource SocialFeedItemContainerStyle}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="NoteList_ItemClick"
                              Visibility="Collapsed">
                        <i:Interaction.Behaviors>
                            <local:SocialContextMenuBehavior/>
                            <local:SocialNoteShortcutsBehavior/>
                            <local:SocialFeedListBehavior BackToNewest="{x:Bind FollowingBackToNewestButton}"/>
                        </i:Interaction.Behaviors>

                        <ListView.Header>
                            <Button x:Name="FollowingBackToNewestButton"
                                    Margin="12,8,12,8"
                                    HorizontalAlignment="Stretch"
                                    Visibility="Collapsed"
                                    Click="BackToNewestButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74A;" FontSize="16" IsTextScaleFactorEnabled="False"/>
                                    <TextBlock x:Uid="SocialBackToNewest"/>
                                </StackPanel>
                            </Button>
                        </ListView.Header>
                    </ListView>

                    <ProgressRing x:Uid="SocialFollowingLoading" x:Name="FollowingLoadingRing"
                                  Width="32" Height="32"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <StackPanel x:Name="FollowingStatePanel"
                                Style="{StaticResource SocialStatePanelStyle}"
                                Visibility="Collapsed">
                        <FontIcon x:Name="FollowingStateGlyph"
                                  FontSize="32"
                                  HorizontalAlignment="Center"
                                  Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                                  AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock x:Name="FollowingStateText"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <Button x:Name="FollowingStateButton"
                                HorizontalAlignment="Center"
                                Click="TimelineStateButton_Click"/>
                    </StackPanel>
                </Grid>
            </PivotItem>

            <PivotItem x:Uid="SocialLocalPivotItem" x:Name="LocalPivotItem">
                <Grid>
                    <ListView x:Uid="SocialLocalList" x:Name="LocalList"
                              ItemTemplate="{StaticResource SocialNoteItemTemplate}"
                              ItemContainerStyle="{StaticResource SocialFeedItemContainerStyle}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="NoteList_ItemClick"
                              Visibility="Collapsed">
                        <i:Interaction.Behaviors>
                            <local:SocialContextMenuBehavior/>
                            <local:SocialNoteShortcutsBehavior/>
                            <local:SocialFeedListBehavior BackToNewest="{x:Bind LocalBackToNewestButton}"/>
                        </i:Interaction.Behaviors>

                        <ListView.Header>
                            <Button x:Name="LocalBackToNewestButton"
                                    Margin="12,8,12,8"
                                    HorizontalAlignment="Stretch"
                                    Visibility="Collapsed"
                                    Click="BackToNewestButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74A;" FontSize="16" IsTextScaleFactorEnabled="False"/>
                                    <TextBlock x:Uid="SocialBackToNewest"/>
                                </StackPanel>
                            </Button>
                        </ListView.Header>
                    </ListView>

                    <ProgressRing x:Uid="SocialLocalLoading" x:Name="LocalLoadingRing"
                                  Width="32" Height="32"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <StackPanel x:Name="LocalStatePanel"
                                Style="{StaticResource SocialStatePanelStyle}"
                                Visibility="Collapsed">
                        <FontIcon x:Name="LocalStateGlyph"
                                  FontSize="32"
                                  HorizontalAlignment="Center"
                                  Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                                  AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock x:Name="LocalStateText"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <Button x:Name="LocalStateButton"
                                HorizontalAlignment="Center"
                                Click="TimelineStateButton_Click"/>
                    </StackPanel>
                </Grid>
            </PivotItem>

            <PivotItem x:Uid="SocialGlobalPivotItem" x:Name="GlobalPivotItem">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <muxc:InfoBar x:Uid="SocialSignedOutInfoBar" x:Name="SignedOutInfoBar"
                                  Margin="0,4,0,8"
                                  Severity="Informational"
                                  IsOpen="False"
                                  IsClosable="False"
                                  Visibility="Collapsed">
                        <muxc:InfoBar.ActionButton>
                            <Button x:Uid="SocialSignedOutSignInButton"
                                    Click="SignInButton_Click"/>
                        </muxc:InfoBar.ActionButton>
                    </muxc:InfoBar>

                    <ListView x:Uid="SocialGlobalList" x:Name="GlobalList"
                              Grid.Row="1"
                              ItemTemplate="{StaticResource SocialNoteItemTemplate}"
                              ItemContainerStyle="{StaticResource SocialFeedItemContainerStyle}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="NoteList_ItemClick"
                              Visibility="Collapsed">
                        <i:Interaction.Behaviors>
                            <local:SocialContextMenuBehavior/>
                            <local:SocialNoteShortcutsBehavior/>
                            <local:SocialFeedListBehavior BackToNewest="{x:Bind GlobalBackToNewestButton}"/>
                        </i:Interaction.Behaviors>

                        <ListView.Header>
                            <Button x:Name="GlobalBackToNewestButton"
                                    Margin="12,8,12,8"
                                    HorizontalAlignment="Stretch"
                                    Visibility="Collapsed"
                                    Click="BackToNewestButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74A;" FontSize="16" IsTextScaleFactorEnabled="False"/>
                                    <TextBlock x:Uid="SocialBackToNewest"/>
                                </StackPanel>
                            </Button>
                        </ListView.Header>
                    </ListView>

                    <ProgressRing x:Uid="SocialGlobalLoading" x:Name="GlobalLoadingRing"
                                  Grid.Row="1"
                                  Width="32" Height="32"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <StackPanel x:Name="GlobalStatePanel"
                                Grid.Row="1"
                                Style="{StaticResource SocialStatePanelStyle}"
                                Visibility="Collapsed">
                        <FontIcon x:Name="GlobalStateGlyph"
                                  FontSize="32"
                                  HorizontalAlignment="Center"
                                  Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                                  AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock x:Name="GlobalStateText"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <Button x:Name="GlobalStateButton"
                                HorizontalAlignment="Center"
                                Click="TimelineStateButton_Click"/>
                    </StackPanel>
                </Grid>
            </PivotItem>

            <PivotItem x:Uid="SocialNotificationsPivotItem" x:Name="NotificationsPivotItem">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <local:SocialTabStrip x:Uid="SocialNotificationsTabs"
                                          x:Name="NotificationsTabStrip"
                                          Margin="0,0,0,4">
                        <local:SocialTabButton x:Name="AllNotificationsTab"
                                               GroupName="SocialNotificationsTabs"
                                               Style="{StaticResource SocialTabButtonStyle}"
                                               Checked="NotificationsTab_Checked">
                            <TextBlock x:Uid="SocialNotificationsAllTab" Style="{StaticResource BaseTextBlockStyle}"/>
                        </local:SocialTabButton>
                        <local:SocialTabButton x:Name="MentionsTab"
                                               GroupName="SocialNotificationsTabs"
                                               Style="{StaticResource SocialTabButtonStyle}"
                                               Checked="NotificationsTab_Checked">
                            <TextBlock x:Uid="SocialNotificationsMentionsTab" Style="{StaticResource BaseTextBlockStyle}"/>
                        </local:SocialTabButton>
                    </local:SocialTabStrip>

                    <Grid x:Name="AllNotificationsHost" Grid.Row="1">
                        <ListView x:Uid="SocialNotificationsList" x:Name="NotificationsList"
                                  ItemTemplate="{StaticResource SocialFeedItemTemplate}"
                                  ItemContainerStyle="{StaticResource SocialFeedItemContainerStyle}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="FeedList_ItemClick"
                                  Visibility="Collapsed">
                            <i:Interaction.Behaviors>
                                <local:SocialContextMenuBehavior/>
                                <local:SocialFeedListBehavior BackToNewest="{x:Bind NotificationsBackToNewestButton}"/>
                            </i:Interaction.Behaviors>

                            <ListView.Header>
                                <Button x:Name="NotificationsBackToNewestButton"
                                        Margin="12,8,12,8"
                                        HorizontalAlignment="Stretch"
                                        Visibility="Collapsed"
                                        Click="BackToNewestButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74A;" FontSize="16" IsTextScaleFactorEnabled="False"/>
                                        <TextBlock x:Uid="SocialBackToNewest"/>
                                    </StackPanel>
                                </Button>
                            </ListView.Header>
                        </ListView>

                        <ProgressRing x:Uid="SocialNotificationsLoading" x:Name="NotificationsLoadingRing"
                                      Width="32" Height="32"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <StackPanel x:Name="NotificationsStatePanel"
                                    Style="{StaticResource SocialStatePanelStyle}"
                                    Visibility="Collapsed">
                            <FontIcon x:Name="NotificationsStateGlyph"
                                      FontSize="32"
                                      HorizontalAlignment="Center"
                                      Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                                      AutomationProperties.AccessibilityView="Raw"/>
                            <TextBlock x:Name="NotificationsStateText"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <Button x:Name="NotificationsStateButton"
                                    HorizontalAlignment="Center"
                                    Click="NotificationsStateButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="MentionsHost" Grid.Row="1" Visibility="Collapsed">
                        <ListView x:Uid="SocialMentionsList" x:Name="MentionsList"
                                  ItemTemplate="{StaticResource SocialFeedItemTemplate}"
                                  ItemContainerStyle="{StaticResource SocialFeedItemContainerStyle}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="FeedList_ItemClick"
                                  Visibility="Collapsed">
                            <i:Interaction.Behaviors>
                                <local:SocialContextMenuBehavior/>
                                <local:SocialFeedListBehavior BackToNewest="{x:Bind MentionsBackToNewestButton}"/>
                            </i:Interaction.Behaviors>

                            <ListView.Header>
                                <Button x:Name="MentionsBackToNewestButton"
                                        Margin="12,8,12,8"
                                        HorizontalAlignment="Stretch"
                                        Visibility="Collapsed"
                                        Click="BackToNewestButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74A;" FontSize="16" IsTextScaleFactorEnabled="False"/>
                                        <TextBlock x:Uid="SocialBackToNewest"/>
                                    </StackPanel>
                                </Button>
                            </ListView.Header>
                        </ListView>

                        <ProgressRing x:Uid="SocialMentionsLoading" x:Name="MentionsLoadingRing"
                                      Width="32" Height="32"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <StackPanel x:Name="MentionsStatePanel"
                                    Style="{StaticResource SocialStatePanelStyle}"
                                    Visibility="Collapsed">
                            <FontIcon x:Name="MentionsStateGlyph"
                                      FontSize="32"
                                      HorizontalAlignment="Center"
                                      Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                                      AutomationProperties.AccessibilityView="Raw"/>
                            <TextBlock x:Name="MentionsStateText"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <Button x:Name="MentionsStateButton"
                                    HorizontalAlignment="Center"
                                    Click="MentionsStateButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
