<Page
    x:Class="Fort.ind_UWP.SettingsAboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fort.ind_UWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid x:Name="RootGrid">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentPanel.Padding" Value="12"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="641"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentPanel.Padding" Value="24"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer x:Name="PageScrollViewer" IsTabStop="True">
            <StackPanel x:Name="ContentPanel" Padding="24">
                <StackPanel MaxWidth="700" HorizontalAlignment="Stretch">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="40"/>
                            <RepositionThemeTransition/>
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>

                    <StackPanel x:Name="AboutSection" Margin="0,0,0,40">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <Border Width="44" Height="44"
                                    Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                                <FontIcon Glyph="&#xE774;" FontSize="22"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          AutomationProperties.AccessibilityView="Raw"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock x:Uid="MainFortInd" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                <TextBlock x:Uid="AboutVersionText" x:Name="AboutVersionText"
                                           Tapped="AboutVersionText_Tapped"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="UpdatesSection" Margin="0,0,0,40">
                        <TextBlock x:Uid="SettingsUpdatesHeading" Style="{StaticResource SubtitleTextBlockStyle}"
                                   AutomationProperties.HeadingLevel="Level2" Margin="0,0,0,16"/>
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button x:Name="CheckForUpdatesButton"
                                        Click="CheckForUpdatesButton_Click"
                                        Style="{StaticResource ButtonRevealStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE895;" FontSize="14" AutomationProperties.AccessibilityView="Raw"/>
                                        <TextBlock x:Uid="CheckForUpdatesButtonText"/>
                                    </StackPanel>
                                </Button>
                                <HyperlinkButton x:Uid="UpdateDownloadLink" x:Name="UpdateDownloadLink"
                                                 VerticalAlignment="Center"
                                                 Visibility="Collapsed"
                                                 Click="UpdateDownloadLink_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="UpdateStatusText"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                       Visibility="Collapsed"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <ToggleSwitch x:Uid="AutoUpdateCheckToggle" x:Name="AutoUpdateCheckToggle"
                                          Toggled="AutoUpdateCheckToggle_Toggled"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="WelcomeSection" Margin="0,0,0,40">
                        <TextBlock x:Uid="MainWelcomeDialog2" Style="{StaticResource SubtitleTextBlockStyle}"
                                   AutomationProperties.HeadingLevel="Level2" Margin="0,0,0,16"/>
                        <StackPanel Spacing="10">
                            <TextBlock x:Uid="MainTheWelcomeDialogAppears"
                                       Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                            <Button x:Name="ResetWelcomeButton"
                                    Click="ResetWelcomeButton_Click"
                                    Style="{StaticResource ButtonRevealStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" AutomationProperties.AccessibilityView="Raw"/>
                                    <TextBlock x:Uid="MainShowWelcomeDialogAgain"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="LinksSection" Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="24">
                            <HyperlinkButton x:Uid="WebsiteLink"
                                             NavigateUri="https://fort1nd.com"
                                             Padding="0" MinHeight="40"
                                             VerticalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE774;" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                                    <TextBlock x:Uid="MainWebsite" Style="{StaticResource BodyTextBlockStyle}"
                                               TextDecorations="Underline"/>
                                </StackPanel>
                            </HyperlinkButton>
                            <HyperlinkButton x:Uid="GitHubLink" x:Name="GitHubLink"
                                             NavigateUri="https://github.com/fort-ind/uwp"
                                             Padding="0" MinHeight="40"
                                             VerticalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE943;" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                                    <TextBlock x:Uid="MainSourceCode" Style="{StaticResource BodyTextBlockStyle}"
                                               TextDecorations="Underline"/>
                                </StackPanel>
                            </HyperlinkButton>
                            <HyperlinkButton x:Uid="IssuesLink" x:Name="IssuesLink"
                                             NavigateUri="https://github.com/fort-ind/uwp/issues"
                                             Padding="0" MinHeight="40"
                                             VerticalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE946;" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                                    <TextBlock x:Uid="MainReportABug" Style="{StaticResource BodyTextBlockStyle}"
                                               TextDecorations="Underline"/>
                                </StackPanel>
                            </HyperlinkButton>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE734;" FontSize="10" VerticalAlignment="Center"
                                      Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                      AutomationProperties.AccessibilityView="Raw"/>
                            <TextBlock x:Uid="MainMadeWithLoveBy"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                       VerticalAlignment="Center"/>
                            <FontIcon Glyph="&#xE734;" FontSize="10" VerticalAlignment="Center"
                                      Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                      AutomationProperties.AccessibilityView="Raw"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="DiagnosticsSection" x:Load="False" Margin="0,40,0,0" Spacing="10">
                        <TextBlock x:Uid="DiagnosticsTitle" Style="{StaticResource SubtitleTextBlockStyle}"
                                   AutomationProperties.HeadingLevel="Level2" Margin="0,0,0,6"/>
                        <TextBlock x:Uid="DiagnosticsDescription"
                                   Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        <Button x:Name="CopyDiagnosticsButton"
                                Click="CopyDiagnosticsButton_Click"
                                Style="{StaticResource ButtonRevealStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" AutomationProperties.AccessibilityView="Raw"/>
                                <TextBlock x:Uid="CopyDiagnosticsButtonText"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="DiagnosticsStatusText"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                   Visibility="Collapsed"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
