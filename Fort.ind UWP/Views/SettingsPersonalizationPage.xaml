<Page
    x:Class="Fort.ind_UWP.SettingsPersonalizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fort.ind_UWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="CustomAccentDialogContentTemplate">
            <StackPanel Spacing="12">
                <ColorPicker x:Name="AccentPicker"
                             IsAlphaEnabled="False"
                             IsHexInputVisible="True"
                             IsColorChannelTextInputVisible="True"/>
                <Grid x:Name="AccentContrastWarning" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7BA;" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0"
                              AutomationProperties.AccessibilityView="Raw"/>
                    <TextBlock x:Name="AccentContrastWarningText" Grid.Column="1" Margin="8,0,0,0"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap"/>
                </Grid>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="RootGrid">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentPanel.Padding" Value="12"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="641"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentPanel.Padding" Value="24"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer x:Name="PageScrollViewer" IsTabStop="True">
            <StackPanel x:Name="ContentPanel" Padding="24">
                <StackPanel MaxWidth="700" HorizontalAlignment="Stretch">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="40"/>
                            <RepositionThemeTransition/>
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>

                    <StackPanel x:Name="AppearanceSection" Margin="0,0,0,40">
                        <TextBlock x:Uid="MainAppearance2" Style="{StaticResource SubtitleTextBlockStyle}"
                                   AutomationProperties.HeadingLevel="Level2" Margin="0,0,0,16"/>
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE793;" FontSize="14" Opacity="0.7" AutomationProperties.AccessibilityView="Raw"/>
                                    <TextBlock x:Uid="MainAppTheme" Style="{StaticResource BodyTextBlockStyle}" FontWeight="SemiBold"
                                               AutomationProperties.HeadingLevel="Level3"/>
                                </StackPanel>
                                <muxc:RadioButtons x:Uid="ThemeRadioGroup" MaxColumns="3">
                                    <RadioButton x:Uid="ThemeSystemRadio" x:Name="ThemeSystemRadio"
                                                 GroupName="AppTheme" Tag="Default"
                                                 Checked="ThemeRadio_Checked"/>
                                    <RadioButton x:Uid="ThemeLightRadio" x:Name="ThemeLightRadio"
                                                 GroupName="AppTheme" Tag="Light"
                                                 Checked="ThemeRadio_Checked"/>
                                    <RadioButton x:Uid="ThemeDarkRadio" x:Name="ThemeDarkRadio"
                                                 GroupName="AppTheme" Tag="Dark"
                                                 Checked="ThemeRadio_Checked"/>
                                </muxc:RadioButtons>
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE771;" FontSize="14" Opacity="0.7" AutomationProperties.AccessibilityView="Raw"/>
                                    <TextBlock x:Uid="MainBackgroundTint" Style="{StaticResource BodyTextBlockStyle}" FontWeight="SemiBold"
                                               AutomationProperties.HeadingLevel="Level3"/>
                                </StackPanel>
                                <StackPanel x:Name="TintSwatchGroup" Spacing="8"
                                            TabFocusNavigation="Once"
                                            XYFocusKeyboardNavigation="Enabled"
                                            GettingFocus="SwatchGroup_GettingFocus"
                                            KeyDown="SwatchGroup_KeyDown">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Uid="TintDefaultButton" x:Name="TintDefaultButton" Tag="Default"
                                                Click="TintColorButton_Click"
                                                Width="40" Height="40" Padding="0" MinWidth="40"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                BorderThickness="2" BorderBrush="Transparent">
                                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <FontIcon Glyph="&#xE8D8;" FontSize="14" AutomationProperties.AccessibilityView="Raw"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <FontIcon x:Name="TintDefaultCheck" Glyph="&#xE73E;" FontSize="12"
                                                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                          Margin="0,0,2,1" Visibility="Collapsed"
                                                          AutomationProperties.AccessibilityView="Raw"/>
                                            </Grid>
                                        </Button>
                                        <Button x:Uid="TintBlueButton" x:Name="TintBlueButton" Tag="#1E3A5F"
                                                Click="TintColorButton_Click"
                                                Width="40" Height="40" Padding="0" MinWidth="40"
                                                Background="#1D6FA5" BorderThickness="2"
                                                BorderBrush="Transparent">
                                            <FontIcon x:Name="TintBlueCheck" Glyph="&#xE73E;" FontSize="12"
                                                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                      Margin="0,0,2,1" Visibility="Collapsed"
                                                      AutomationProperties.AccessibilityView="Raw"/>
                                        </Button>
                                        <Button x:Uid="TintPurpleButton" x:Name="TintPurpleButton" Tag="#2D1B69"
                                                Click="TintColorButton_Click"
                                                Width="40" Height="40" Padding="0" MinWidth="40"
                                                Background="#6041B0" BorderThickness="2"
                                                BorderBrush="Transparent">
                                            <FontIcon x:Name="TintPurpleCheck" Glyph="&#xE73E;" FontSize="12"
                                                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                      Margin="0,0,2,1" Visibility="Collapsed"
                                                      AutomationProperties.AccessibilityView="Raw"/>
                                        </Button>
                                        <Button x:Uid="TintGreenButton" x:Name="TintGreenButton" Tag="#0F3D2E"
                                                Click="TintColorButton_Click"
                                                Width="40" Height="40" Padding="0" MinWidth="40"
                                                Background="#1B7A4E" BorderThickness="2"
                                                BorderBrush="Transparent">
                                            <FontIcon x:Name="TintGreenCheck" Glyph="&#xE73E;" FontSize="12"
                                                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                      Margin="0,0,2,1" Visibility="Collapsed"
                                                      AutomationProperties.AccessibilityView="Raw"/>
                                        </Button>
                                        <Button x:Uid="TintRedButton" x:Name="TintRedButton" Tag="#3D1515"
                                                Click="TintColorButton_Click"
                                                Width="40" Height="40" Padding="0" MinWidth="40"
                                                Background="#B03232" BorderThickness="2"
                                                BorderBrush="Transparent">
                                            <FontIcon x:Name="TintRedCheck" Glyph="&#xE73E;" FontSize="12"
                                                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                      Margin="0,0,2,1" Visibility="Collapsed"
                                                      AutomationProperties.AccessibilityView="Raw"/>
                                        </Button>
                                        <Button x:Uid="TintSlateButton" x:Name="TintSlateButton" Tag="#1A1A2E"
                                                Click="TintColorButton_Click"
                                                Width="40" Height="40" Padding="0" MinWidth="40"
                                                Background="#404080" BorderThickness="2"
                                                BorderBrush="Transparent">
                                            <FontIcon x:Name="TintSlateCheck" Glyph="&#xE73E;" FontSize="12"
                                                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                      Margin="0,0,2,1" Visibility="Collapsed"
                                                      AutomationProperties.AccessibilityView="Raw"/>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Uid="TintTealButton" x:Name="TintTealButton" Tag="#0E3A3A"
                                                Click="TintColorButton_Click"
                                                Width="40" Height="40" Padding="0" MinWidth="40"
                                                Background="#1B8A8A" BorderThickness="2"
                                                BorderBrush="Transparent">
                                            <FontIcon x:Name="TintTealCheck" Glyph="&#xE73E;" FontSize="12"
                                                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                      Margin="0,0,2,1" Visibility="Collapsed"
                                                      AutomationProperties.AccessibilityView="Raw"/>
                                        </Button>
                                        <Button x:Uid="TintBronzeButton" x:Name="TintBronzeButton" Tag="#3D2A0F"
                                                Click="TintColorButton_Click"
                                                Width="40" Height="40" Padding="0" MinWidth="40"
                                                Background="#B07D1B" BorderThickness="2"
                                                BorderBrush="Transparent">
                                            <FontIcon x:Name="TintBronzeCheck" Glyph="&#xE73E;" FontSize="12"
                                                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                      Margin="0,0,2,1" Visibility="Collapsed"
                                                      AutomationProperties.AccessibilityView="Raw"/>
                                        </Button>
                                        <Button x:Uid="TintRoseButton" x:Name="TintRoseButton" Tag="#3D1533"
                                                Click="TintColorButton_Click"
                                                Width="40" Height="40" Padding="0" MinWidth="40"
                                                Background="#B03291" BorderThickness="2"
                                                BorderBrush="Transparent">
                                            <FontIcon x:Name="TintRoseCheck" Glyph="&#xE73E;" FontSize="12"
                                                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                      Margin="0,0,2,1" Visibility="Collapsed"
                                                      AutomationProperties.AccessibilityView="Raw"/>
                                        </Button>
                                        <Button x:Uid="TintOliveButton" x:Name="TintOliveButton" Tag="#2E3D0F"
                                                Click="TintColorButton_Click"
                                                Width="40" Height="40" Padding="0" MinWidth="40"
                                                Background="#6E8A1B" BorderThickness="2"
                                                BorderBrush="Transparent">
                                            <FontIcon x:Name="TintOliveCheck" Glyph="&#xE73E;" FontSize="12"
                                                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                      Margin="0,0,2,1" Visibility="Collapsed"
                                                      AutomationProperties.AccessibilityView="Raw"/>
                                        </Button>
                                        <Button x:Uid="TintGraphiteButton" x:Name="TintGraphiteButton" Tag="#232323"
                                                Click="TintColorButton_Click"
                                                Width="40" Height="40" Padding="0" MinWidth="40"
                                                Background="#5A5A5A" BorderThickness="2"
                                                BorderBrush="Transparent">
                                            <FontIcon x:Name="TintGraphiteCheck" Glyph="&#xE73E;" FontSize="12"
                                                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                      Margin="0,0,2,1" Visibility="Collapsed"
                                                      AutomationProperties.AccessibilityView="Raw"/>
                                        </Button>
                                        <Button x:Uid="TintCustomButton" x:Name="TintCustomButton"
                                                Click="CustomTintButton_Click"
                                                Width="40" Height="40" Padding="0" MinWidth="40"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                BorderThickness="2" BorderBrush="Transparent">
                                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <FontIcon x:Name="TintCustomIcon" Glyph="&#xE790;" FontSize="14" AutomationProperties.AccessibilityView="Raw"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <FontIcon x:Name="TintCustomCheck" Glyph="&#xE73E;" FontSize="12"
                                                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                          Margin="0,0,2,1" Visibility="Collapsed"
                                                          AutomationProperties.AccessibilityView="Raw"/>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock x:Uid="MainApplyTintTo"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                    <muxc:RadioButtons x:Uid="TintScopeRadioGroup" MaxColumns="3">
                                        <RadioButton x:Uid="TintScopeContentRadio" x:Name="TintScopeContentRadio"
                                                     GroupName="AppTintScope" Tag="Content"
                                                     Checked="TintScopeRadio_Checked"/>
                                        <RadioButton x:Uid="TintScopeSidebarRadio" x:Name="TintScopeSidebarRadio"
                                                     GroupName="AppTintScope" Tag="Sidebar"
                                                     Checked="TintScopeRadio_Checked"/>
                                        <RadioButton x:Uid="TintScopeBothRadio" x:Name="TintScopeBothRadio"
                                                     GroupName="AppTintScope" Tag="Both"
                                                     Checked="TintScopeRadio_Checked"/>
                                    </muxc:RadioButtons>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE790;" FontSize="14" Opacity="0.7" AutomationProperties.AccessibilityView="Raw"/>
                                    <TextBlock x:Uid="MainAccentColor" Style="{StaticResource BodyTextBlockStyle}" FontWeight="SemiBold"
                                               AutomationProperties.HeadingLevel="Level3"/>
                                </StackPanel>
                                <StackPanel x:Name="AccentSwatchGroup" Spacing="8"
                                            TabFocusNavigation="Once"
                                            XYFocusKeyboardNavigation="Enabled"
                                            GettingFocus="SwatchGroup_GettingFocus"
                                            KeyDown="SwatchGroup_KeyDown">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Uid="AccentSystemButton" x:Name="AccentSystemButton" Tag="Default"
                                                Click="AccentColorButton_Click"
                                                Width="40" Height="40" Padding="0" MinWidth="40"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                BorderThickness="2" BorderBrush="Transparent">
                                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <FontIcon Glyph="&#xE770;" FontSize="14" AutomationProperties.AccessibilityView="Raw"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <FontIcon x:Name="AccentSystemCheck" Glyph="&#xE73E;" FontSize="12"
                                                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                          Margin="0,0,2,1" Visibility="Collapsed"
                                                          AutomationProperties.AccessibilityView="Raw"/>
                                            </Grid>
                                        </Button>
                                        <Button x:Uid="AccentMatchTintButton" x:Name="AccentMatchTintButton" Tag="MatchTint"
                                                Click="AccentColorButton_Click"
                                                Width="40" Height="40" Padding="0" MinWidth="40"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                BorderThickness="2" BorderBrush="Transparent">
                                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <FontIcon x:Name="AccentMatchTintIcon" Glyph="&#xE71B;" FontSize="14" AutomationProperties.AccessibilityView="Raw"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <FontIcon x:Name="AccentMatchTintCheck" Glyph="&#xE73E;" FontSize="12"
                                                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                          Margin="0,0,2,1" Visibility="Collapsed"
                                                          AutomationProperties.AccessibilityView="Raw"/>
                                            </Grid>
                                        </Button>
                                        <Button x:Uid="AccentBlueButton" x:Name="AccentBlueButton" Tag="#0078D7"
                                                Click="AccentColorButton_Click"
                                                Width="40" Height="40" Padding="0" MinWidth="40"
                                                Background="#0078D7" BorderThickness="2"
                                                BorderBrush="Transparent">
                                            <FontIcon x:Name="AccentBlueCheck" Glyph="&#xE73E;" FontSize="12"
                                                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                      Margin="0,0,2,1" Visibility="Collapsed"
                                                      AutomationProperties.AccessibilityView="Raw"/>
                                        </Button>
                                        <Button x:Uid="AccentIrisButton" x:Name="AccentIrisButton" Tag="#8764B8"
                                                Click="AccentColorButton_Click"
                                                Width="40" Height="40" Padding="0" MinWidth="40"
                                                Background="#8764B8" BorderThickness="2"
                                                BorderBrush="Transparent">
                                            <FontIcon x:Name="AccentIrisCheck" Glyph="&#xE73E;" FontSize="12"
                                                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                      Margin="0,0,2,1" Visibility="Collapsed"
                                                      AutomationProperties.AccessibilityView="Raw"/>
                                        </Button>
                                        <Button x:Uid="AccentOrchidButton" x:Name="AccentOrchidButton" Tag="#C239B3"
                                                Click="AccentColorButton_Click"
                                                Width="40" Height="40" Padding="0" MinWidth="40"
                                                Background="#C239B3" BorderThickness="2"
                                                BorderBrush="Transparent">
                                            <FontIcon x:Name="AccentOrchidCheck" Glyph="&#xE73E;" FontSize="12"
                                                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                      Margin="0,0,2,1" Visibility="Collapsed"
                                                      AutomationProperties.AccessibilityView="Raw"/>
                                        </Button>
                                        <Button x:Uid="AccentRoseButton" x:Name="AccentRoseButton" Tag="#EA005E"
                                                Click="AccentColorButton_Click"
                                                Width="40" Height="40" Padding="0" MinWidth="40"
                                                Background="#EA005E" BorderThickness="2"
                                                BorderBrush="Transparent">
                                            <FontIcon x:Name="AccentRoseCheck" Glyph="&#xE73E;" FontSize="12"
                                                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                      Margin="0,0,2,1" Visibility="Collapsed"
                                                      AutomationProperties.AccessibilityView="Raw"/>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Uid="AccentRedButton" x:Name="AccentRedButton" Tag="#E81123"
                                                Click="AccentColorButton_Click"
                                                Width="40" Height="40" Padding="0" MinWidth="40"
                                                Background="#E81123" BorderThickness="2"
                                                BorderBrush="Transparent">
                                            <FontIcon x:Name="AccentRedCheck" Glyph="&#xE73E;" FontSize="12"
                                                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                      Margin="0,0,2,1" Visibility="Collapsed"
                                                      AutomationProperties.AccessibilityView="Raw"/>
                                        </Button>
                                        <Button x:Uid="AccentOrangeButton" x:Name="AccentOrangeButton" Tag="#CA5010"
                                                Click="AccentColorButton_Click"
                                                Width="40" Height="40" Padding="0" MinWidth="40"
                                                Background="#CA5010" BorderThickness="2"
                                                BorderBrush="Transparent">
                                            <FontIcon x:Name="AccentOrangeCheck" Glyph="&#xE73E;" FontSize="12"
                                                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                      Margin="0,0,2,1" Visibility="Collapsed"
                                                      AutomationProperties.AccessibilityView="Raw"/>
                                        </Button>
                                        <Button x:Uid="AccentGreenButton" x:Name="AccentGreenButton" Tag="#10893E"
                                                Click="AccentColorButton_Click"
                                                Width="40" Height="40" Padding="0" MinWidth="40"
                                                Background="#10893E" BorderThickness="2"
                                                BorderBrush="Transparent">
                                            <FontIcon x:Name="AccentGreenCheck" Glyph="&#xE73E;" FontSize="12"
                                                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                      Margin="0,0,2,1" Visibility="Collapsed"
                                                      AutomationProperties.AccessibilityView="Raw"/>
                                        </Button>
                                        <Button x:Uid="AccentSeafoamButton" x:Name="AccentSeafoamButton" Tag="#038387"
                                                Click="AccentColorButton_Click"
                                                Width="40" Height="40" Padding="0" MinWidth="40"
                                                Background="#038387" BorderThickness="2"
                                                BorderBrush="Transparent">
                                            <FontIcon x:Name="AccentSeafoamCheck" Glyph="&#xE73E;" FontSize="12"
                                                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                      Margin="0,0,2,1" Visibility="Collapsed"
                                                      AutomationProperties.AccessibilityView="Raw"/>
                                        </Button>
                                        <Button x:Uid="AccentGrayButton" x:Name="AccentGrayButton" Tag="#7A7574"
                                                Click="AccentColorButton_Click"
                                                Width="40" Height="40" Padding="0" MinWidth="40"
                                                Background="#7A7574" BorderThickness="2"
                                                BorderBrush="Transparent">
                                            <FontIcon x:Name="AccentGrayCheck" Glyph="&#xE73E;" FontSize="12"
                                                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                      Margin="0,0,2,1" Visibility="Collapsed"
                                                      AutomationProperties.AccessibilityView="Raw"/>
                                        </Button>
                                        <Button x:Uid="AccentCustomButton" x:Name="AccentCustomButton"
                                                Click="CustomAccentButton_Click"
                                                Width="40" Height="40" Padding="0" MinWidth="40"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                BorderThickness="2" BorderBrush="Transparent">
                                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <FontIcon x:Name="AccentCustomIcon" Glyph="&#xE790;" FontSize="14" AutomationProperties.AccessibilityView="Raw"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <FontIcon x:Name="AccentCustomCheck" Glyph="&#xE73E;" FontSize="12"
                                                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                          Margin="0,0,2,1" Visibility="Collapsed"
                                                          AutomationProperties.AccessibilityView="Raw"/>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="AccentRestartNotice" Visibility="Collapsed"
                                            Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                                    <TextBlock x:Uid="AccentRestartNoticeText"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                               VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
                                    <Button x:Uid="AccentRestartButton" x:Name="AccentRestartButton"
                                            Click="AccentRestartButton_Click"
                                            VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="TransparencySection" Margin="0,0,0,40">
                        <TextBlock x:Uid="MainTransparency2" Style="{StaticResource SubtitleTextBlockStyle}"
                                   AutomationProperties.HeadingLevel="Level2" Margin="0,0,0,16"/>
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="MainTransparencyHint"
                                       Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>

                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="MainContentTransparency"
                                           Style="{StaticResource CaptionTextBlockStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Uid="BodyAcrylicSlider" x:Name="BodyAcrylicSlider"
                                            Width="280"
                                            Minimum="20" Maximum="100" StepFrequency="1"
                                            VerticalAlignment="Center"
                                            ValueChanged="BodyAcrylicSlider_ValueChanged"
                                            PointerCaptureLost="AcrylicSlider_PointerCaptureLost"
                                            LostFocus="AcrylicSlider_LostFocus"/>
                                    <TextBlock x:Name="BodyAcrylicValue" Grid.Column="1"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               AutomationProperties.AccessibilityView="Raw"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="MainSidebarTransparency"
                                           Style="{StaticResource CaptionTextBlockStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Uid="PaneAcrylicSlider" x:Name="PaneAcrylicSlider"
                                            Width="280"
                                            Minimum="20" Maximum="100" StepFrequency="1"
                                            VerticalAlignment="Center"
                                            ValueChanged="PaneAcrylicSlider_ValueChanged"
                                            PointerCaptureLost="AcrylicSlider_PointerCaptureLost"
                                            LostFocus="AcrylicSlider_LostFocus"/>
                                    <TextBlock x:Name="PaneAcrylicValue" Grid.Column="1"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               AutomationProperties.AccessibilityView="Raw"/>
                                </Grid>
                            </StackPanel>

                            <Grid x:Name="AcrylicWarning" Opacity="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7BA;" FontSize="14"
                                          VerticalAlignment="Top" Margin="0,2,0,0"
                                          AutomationProperties.AccessibilityView="Raw"/>
                                <TextBlock x:Name="AcrylicWarningText" Grid.Column="1" Margin="8,0,0,0"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="InkSection">
                        <TextBlock x:Uid="MainInk2" Style="{StaticResource SubtitleTextBlockStyle}"
                                   AutomationProperties.HeadingLevel="Level2" Margin="0,0,0,16"/>
                        <ToggleSwitch x:Uid="InkMouseToggle" x:Name="InkMouseToggle"
                                      Toggled="InkMouseToggle_Toggled"/>
                        <TextBlock x:Uid="InkMouseDescription"
                                   Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        <ToggleSwitch x:Uid="InkTouchPanToggle" x:Name="InkTouchPanToggle"
                                      Margin="0,14,0,0"
                                      Toggled="InkTouchPanToggle_Toggled"/>
                        <TextBlock x:Uid="InkTouchPanDescription"
                                   Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        <ComboBox x:Uid="InkPenTextModeCombo" x:Name="InkPenTextModeCombo"
                                  Margin="0,14,0,8"
                                  MinWidth="200"
                                  SelectionChanged="InkPenTextModeCombo_SelectionChanged">
                            <ComboBoxItem x:Uid="InkPenTextModeWriteOnBox" Tag="WriteOnBox"/>
                            <ComboBoxItem x:Uid="InkPenTextModeWindowsView" Tag="WindowsView"/>
                            <ComboBoxItem x:Uid="InkPenTextModeOff" Tag="Off"/>
                        </ComboBox>
                        <TextBlock x:Uid="InkPenTextBoxDescription"
                                   Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        <ToggleSwitch x:Uid="InkHandwritingFontToggle" x:Name="InkHandwritingFontToggle"
                                      Margin="0,14,0,0"
                                      Toggled="InkHandwritingFontToggle_Toggled"/>
                        <TextBlock x:Uid="InkHandwritingFontDescription"
                                   Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
