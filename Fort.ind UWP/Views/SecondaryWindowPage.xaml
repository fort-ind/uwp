<Page
    x:Class="Fort.ind_UWP.SecondaryWindowPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fort.ind_UWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    mc:Ignorable="d"
    KeyboardAcceleratorPlacementMode="Hidden"
    Background="Transparent">

    <i:Interaction.Behaviors>
        <local:WindowActivationStateBehavior ActiveStateName="WindowActiveState"
                                             InactiveStateName="WindowInactiveState"/>
    </i:Interaction.Behaviors>

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowActivationStates">
                <VisualState x:Name="WindowActiveState"/>
                <VisualState x:Name="WindowInactiveState">
                    <VisualState.Setters>
                        <Setter Target="WindowTitleText.Foreground" Value="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="HighContrastSurface"
                Grid.RowSpan="3"
                Background="{ThemeResource HighContrastWindowSurfaceBrush}"
                IsHitTestVisible="False"/>

        <Grid x:Name="AppTitleBar"
              Height="32"
              Background="{ThemeResource SystemControlBackgroundListLowBrush}"
              BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInset" Width="0"/>
                <ColumnDefinition x:Name="TitleBarBackButtonSpace" Width="0"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="TitleBarRightInset" Width="0"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="WindowTitleText"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
        </Grid>

        <Button x:Uid="TitleBarBackButton" x:Name="TitleBarBackButton"
                Style="{StaticResource NavigationBackButtonNormalStyle}"
                Width="48"
                Height="32"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Visibility="Collapsed"
                IsEnabled="False"
                Click="TitleBarBackButton_Click"/>

        <TextBlock x:Name="HeaderText"
                   Grid.Row="1"
                   Style="{StaticResource TitleTextBlockStyle}"
                   AutomationProperties.HeadingLevel="Level1"
                   TextTrimming="CharacterEllipsis"
                   Margin="24,5,24,11"/>

        <Frame x:Name="ContentFrame"
               Grid.Row="2"
               AutomationProperties.LandmarkType="Main"
               Navigated="ContentFrame_Navigated"/>
    </Grid>
</Page>
