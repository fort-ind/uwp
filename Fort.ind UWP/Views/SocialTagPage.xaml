<Page
    x:Class="Fort.ind_UWP.SocialTagPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fort.ind_UWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    mc:Ignorable="d"
    KeyboardAcceleratorPlacementMode="Hidden"
    Background="Transparent"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.Resources>
        <DataTemplate x:Key="SocialNoteItemTemplate" x:DataType="local:SocialNoteItem">
            <local:SocialNoteView Item="{x:Bind}"
                                  AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"/>
        </DataTemplate>

        <Style x:Key="SocialTagContainerStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="NoteList.Margin" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="641"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="NoteList.Margin" Value="12,0,12,0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ListView x:Name="NoteList"
                  MaxWidth="720"
                  ItemTemplate="{StaticResource SocialNoteItemTemplate}"
                  ItemContainerStyle="{StaticResource SocialTagContainerStyle}"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="NoteList_ItemClick">
            <i:Interaction.Behaviors>
                <local:SocialContextMenuBehavior/>
                <local:SocialNoteShortcutsBehavior/>
                <local:SocialFeedListBehavior BackToNewest="{x:Bind BackToNewestButton}"/>
            </i:Interaction.Behaviors>

            <ListView.Header>
                <StackPanel>
                    <Grid BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                          BorderThickness="0,0,0,1"
                          Padding="12,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="CaptionText"
                                   Style="{StaticResource BaseTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"/>

                        <Button x:Uid="SocialTagRefreshButton"
                                x:Name="RefreshButton"
                                Grid.Column="1"
                                Style="{StaticResource ButtonRevealStyle}"
                                Background="Transparent"
                                Width="40" Height="40"
                                MinWidth="40" MinHeight="40"
                                Padding="0"
                                CornerRadius="0"
                                VerticalAlignment="Center"
                                Click="RefreshButton_Click">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="F5"/>
                            </Button.KeyboardAccelerators>
                            <FontIcon Glyph="&#xE72C;" FontSize="16" IsTextScaleFactorEnabled="False"/>
                        </Button>
                    </Grid>

                    <Button x:Name="BackToNewestButton"
                            Margin="12,8,12,8"
                            HorizontalAlignment="Stretch"
                            Visibility="Collapsed"
                            Click="RefreshButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74A;" FontSize="16" IsTextScaleFactorEnabled="False"/>
                            <TextBlock x:Uid="SocialBackToNewest"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ListView.Header>

            <ListView.Footer>
                <Grid x:Name="FooterHost" MinHeight="160" Padding="12,24,12,24">
                    <ProgressRing x:Uid="SocialTagLoading"
                                  x:Name="LoadingRing"
                                  Width="32" Height="32"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Top"/>

                    <StackPanel x:Name="StatePanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                MaxWidth="360"
                                Spacing="12"
                                Visibility="Collapsed">
                        <FontIcon x:Name="StateGlyph"
                                  FontSize="32"
                                  HorizontalAlignment="Center"
                                  Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                                  AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock x:Name="StateText"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <Button x:Name="StateButton"
                                HorizontalAlignment="Center"
                                Click="StateButton_Click"/>
                    </StackPanel>
                </Grid>
            </ListView.Footer>
        </ListView>
    </Grid>
</Page>
