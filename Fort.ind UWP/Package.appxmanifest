<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  IgnorableNamespaces="uap mp uap5">

  <Identity
    Name="fortind.desktopPreview"
    Publisher="CN=fort.ind"
    Version="2.2.0.0" />

  <mp:PhoneIdentity PhoneProductId="842aa337-86c0-43da-82da-a0aa21c2fc6d" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <!-- Display strings are ms-resource: references into Strings\<lang>\Resources.resw, so the
       shell and the Store show them in the user's language. Requires the <Resources> element
       below, which is already generating one entry per resw language folder. PublisherDisplayName
       stays literal: it is a legal entity name, not display copy. -->
  <Properties>
    <DisplayName>fort.desktop</DisplayName>
    <PublisherDisplayName>fort.ind</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
	  <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="Fort.ind_UWP.App">
      <uap:VisualElements
        DisplayName="ms-resource:AppDisplayName"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="ms-resource:AppDescription"
        BackgroundColor="transparent">
		  <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square310x310Logo="Assets\Square310x310Logo.png" ShortName="fort.uwp" Square71x71Logo="Assets\SmallTile.png">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square310x310Logo"/>
          </uap:ShowNameOnTiles>
        </uap:DefaultTile >
        <!-- BackgroundColor is explicit because the splash is painted by the shell before any
             app code runs, so it cannot follow the user's Light/Dark setting - there is no MRT
             theme qualifier for it. Left unset, UWP defaults it to #464646, a dark grey that
             reads as "the app launched in the wrong theme" to anyone running Light. A saturated
             brand colour reads as deliberate in either theme instead. #2D1B69 is the same
             Deep Purple already in the app's own tint palette, and the splash PNG has a fully
             transparent background, so this colour IS the entire backdrop.

             uap5:Optional lets Windows skip the splash altogether when the app starts quickly
             enough, which is the common case now that session restore is deferred off the
             launch path - so most launches show no splash at all. It still appears when startup
             genuinely drags, which is the only time it was earning its keep. Requires 1803;
             this project's floor is 1809. -->
        <uap:SplashScreen Image="Assets\SplashScreen.png"
                          BackgroundColor="#2D1B69"
                          uap5:Optional="true" />
		  <uap:LockScreen BadgeLogo="Assets\BadgeLogo.png" Notification="badge"/>
		  <uap:InitialRotationPreference>
		  <uap:Rotation Preference="landscape"/>
		  <uap:Rotation Preference="landscapeFlipped"/>
		  <uap:Rotation Preference="portrait"/>
		  <uap:Rotation Preference="portraitFlipped"/></uap:InitialRotationPreference>
      </uap:VisualElements>
      <Extensions>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="fortind">
            <uap:DisplayName>ms-resource:ProtocolDisplayName</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
  </Capabilities>
</Package>